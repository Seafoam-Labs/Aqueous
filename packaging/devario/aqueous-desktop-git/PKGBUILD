# Maintainer: Devario maintainers
# Build identity only; the recipe emits no aqueous-desktop-git package.
pkgbase=aqueous-desktop-git
pkgname=(aqueous-core-git aqueous-session-git xdg-desktop-portal-aqueous-git
         aqueous-integration-pearl-git aqueous-shell-pearl-git devario-desktop-git)
pkgver=1.0.6
pkgrel=1
pkgdesc='Devario Pearl desktop with Aqueous Git (replaces stable)'
arch=('x86_64' 'aarch64')
url='https://github.com/Seafoam-Labs/Aqueous'
license=('GPL-3.0-only' 'MIT')
options=('!strip' '!debug' '!zipman')
makedepends=('patchelf' 'git' 'curl' 'patch' 'scdoc' 'jq' 'python' 'shaderc' 'clang' 'lld' 'llvm'
             'wayland-protocols>=1.49' 'pkgconf' 'meson' 'ninja' 'glslang'
             'vulkan-headers' 'hwdata' 'zig=0.16.0' 'libinih' 'freetype2' 'wayland'
             'libxkbcommon' 'libinput' 'pixman' 'libpng' 'libdrm' 'libevdev' 'libdecor'
             'xorg-xwayland' 'pipewire' 'glib2' 'fontconfig' 'mesa' 'systemd-libs'
             'seatd' 'libdisplay-info' 'libliftoff' 'lcms2' 'vulkan-icd-loader'
             'libxcb' 'xcb-util-errors' 'xcb-util-wm' 'xcb-util-renderutil' 'gtk4')
checkdepends=('libarchive' 'ripgrep' 'gsettings-desktop-schemas')
source=('session.toml'
        "aqueous::git+${url}.git"
        'wlroots-0.20.2.tar.gz::https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/0.20.2/wlroots-0.20.2.tar.gz'
        'xdg-desktop-portal-wlr-0.8.4.tar.gz::https://github.com/emersion/xdg-desktop-portal-wlr/archive/refs/tags/v0.8.4.tar.gz')
sha256sums=('2cecdd6b68deaedc81997669b26ddfb705c458c8de9d8fdd465aaae35eba845b'
            'SKIP' '972c7ac44b17828f4702bfae7cd8347346a3fb5b2c1076cfa2c3fcedac5ec343'
            '3122966d46ab108f505525bcb2498f9121b446ee8438fbfceb73a7a1fa1ad400')
pkgver() {
    cd "$srcdir/aqueous"
    local version
    version=$(git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
    if [[ -z $version ]]; then version="1.0.6.r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"; fi
    printf '%s\n' "$version"
}

prepare() {
    patch --fuzz=0 -d "$srcdir/xdg-desktop-portal-wlr-0.8.4" -Np1 \
        -i "$srcdir/aqueous/packaging/portal/0001-rename-backend-for-aqueous.patch"
}

build() {
    # x86-64-v3 is shared by supported Intel and AMD CPUs; ARM stays baseline.
    case ${CARCH:-$(uname -m)} in
        x86_64)
            AQUEOUS_ZIG_CPU=x86_64_v3
            export CFLAGS="${CFLAGS:+$CFLAGS }-march=x86-64-v3 -mtune=generic"
            export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-march=x86-64-v3 -mtune=generic"
            ;;
        aarch64) AQUEOUS_ZIG_CPU=baseline ;;
        *) printf 'Unsupported package architecture: %s\n' "${CARCH:-$(uname -m)}" >&2; return 1 ;;
    esac
    # Canonical configuration helper; Pearl supplies the settings UI.
    ZIG_GLOBAL_CACHE_DIR="$srcdir/aqueous-config-zig-global" \
    ZIG_LOCAL_CACHE_DIR="$srcdir/aqueous-config-zig-local" \
        zig build --build-file "$srcdir/aqueous/settingsApplication/build.zig" \
        -Dcpu="$AQUEOUS_ZIG_CPU" -Doptimize=ReleaseSafe --prefix "$srcdir/aqueous-config-dist"

    # Build the Aqueous compositor/policy executable and inspection client.
    msg2 "Building Aqueous compositor..."
    cd "$srcdir/aqueous/compositor"
    # Recreate generated protocol metadata so incremental builds cannot ship retired names.
    rm -rf -- "$srcdir/aqueous-dist/share/aqueous-protocols"
    # -Dllvm forces the LLVM backend + LLD linker. Zig 0.16.0's self-hosted
    # ELF linker can't handle R_X86_64_PC64 in .sframe emitted by gcc >= 16.
    # Keep the manuals deterministic in clean chroots. In-tree builds make
    # them optional when scdoc is absent, but packages must always document
    # both installed executables, including aqueousctl.
    AQUEOUS_WLROOTS_CACHE_DIR="$srcdir" \
        scripts/build-wlroots-render-hook.sh
    PKG_CONFIG_PATH="$PWD/.deps/wlroots-render-hook/lib/pkgconfig" \
    zig build -Dcpu="$AQUEOUS_ZIG_CPU" -Doptimize=ReleaseSafe -Dxwayland -Dllvm \
        -Dman-pages=true -Dversion-string="$pkgver" \
        --prefix "$srcdir/aqueous-dist" install

    cd "$srcdir"
    # This target builds the screen-sharing picker without the Welcome app.
    ZIG_GLOBAL_CACHE_DIR="$srcdir/aqueous-picker-zig-global" \
    ZIG_LOCAL_CACHE_DIR="$srcdir/aqueous-picker-zig-local" \
        zig build --build-file "$srcdir/aqueous/welcome/build.zig" picker \
        -Dcpu="$AQUEOUS_ZIG_CPU" -Doptimize=ReleaseSafe --prefix "$srcdir/aqueous-picker-dist"
    sh "$srcdir/aqueous/packaging/portal/build-aqueous-portal.sh" \
        "$srcdir/xdg-desktop-portal-wlr-0.8.4" \
        "$srcdir/aqueous-portal-build" "$srcdir/aqueous-portal-dist"
}

check() {
    ZIG_GLOBAL_CACHE_DIR="$srcdir/aqueous-config-zig-global" \
    ZIG_LOCAL_CACHE_DIR="$srcdir/aqueous-config-zig-local" \
        zig build --build-file "$srcdir/aqueous/settingsApplication/build.zig" test test-driver -Dmodel-only=true --prefix "$srcdir/aqueous-config-tests"
    AQUEOUS_CONFIG_BINARY="$srcdir/aqueous-config-dist/bin/aqueous-config" \
    AQUEOUSCTL_BINARY="$srcdir/aqueous-dist/bin/aqueousctl" \
        "$srcdir/aqueous/settingsApplication/tests/test-packaging.sh"
    "$srcdir/aqueous/settingsApplication/tests/test-backend.sh" "$srcdir/aqueous-config-tests/bin/aqueous-backend-test"

    # aqueousctl and its protocol/manual are one feature: reject a partial
    # install tree before package() copies it into the package image.
    local required=(
        bin/aqueous
        bin/aqueous-activity-launch
        bin/aqueousctl
        lib/aqueous/libwlroots-0.20.so
        share/man/man1/aqueousctl.1
        share/aqueous-protocols/stable/aqueous-window-info-v1.xml
        share/aqueous-protocols/stable/aqueous-window-management-v1.xml
        share/aqueous-protocols/stable/aqueous-input-management-v1.xml
        share/aqueous-protocols/stable/aqueous-xkb-bindings-v1.xml
        share/aqueous-protocols/stable/aqueous-xkb-config-v1.xml
        share/aqueous-protocols/stable/aqueous-libinput-config-v1.xml
        share/aqueous-protocols/stable/aqueous-layer-shell-v1.xml
    )
    local path
    for path in "${required[@]}"; do
        if [[ ! -e "$srcdir/aqueous-dist/$path" ]]; then
            error "build output is missing required file: $path"
            return 1
        fi
    done
    cmp "$srcdir/aqueous-dist/lib/aqueous/libwlroots-0.20.so" \
        "$srcdir/aqueous/compositor/.deps/wlroots-render-hook/lib/libwlroots-0.20.so"
    readelf -d "$srcdir/aqueous-dist/bin/aqueous" |
        grep -F '$ORIGIN/../lib/aqueous' >/dev/null
    if readelf -d "$srcdir/aqueous-dist/bin/aqueous" |
        grep -i 'scenefx' >/dev/null; then
        error "compositor still links SceneFX"
        return 1
    fi

    test -x "$srcdir/aqueous-picker-dist/bin/aqueous-portal-picker"
    test ! -e "$srcdir/aqueous-picker-dist/bin/aqueous-welcome"
    bash "$srcdir/aqueous/packaging/tests/test-portal-packaging.sh" \
        "$srcdir/aqueous-portal-dist/usr/lib/aqueous/xdg-desktop-portal-aqueous"
}

package_aqueous-core-git() {
    pkgdesc='Aqueous compositor, configuration helper and control client'
    license=('GPL-3.0-only' 'MIT' '0BSD' 'CC-BY-SA-4.0')
    depends=("freetype2" "wayland" "libxkbcommon" "libinput" "pixman" "libpng" "libdrm" "libevdev" "libdecor" "xorg-xwayland" "pipewire" "glib2" "fontconfig" "mesa" "systemd-libs" "seatd" "libdisplay-info" "libliftoff" "lcms2" "vulkan-icd-loader" "libxcb" "xcb-util-errors" "xcb-util-wm" "xcb-util-renderutil" "brightnessctl" "playerctl")
    provides=("aqueous=$pkgver" "aqueous-core=$pkgver-$pkgrel")
    conflicts=('aqueous-core' 'aqueous' 'aqueous-bin' 'aqueous-git<1.0.2.r6' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-core-bin')
    AQUEOUS_COMPOSITOR_DIST="$srcdir/aqueous-dist" \
    AQUEOUS_CONFIG_BINARY="$srcdir/aqueous-config-dist/bin/aqueous-config" \
        DESTDIR="$pkgdir" PREFIX=/usr bash "$srcdir/aqueous/packaging/stage-component.sh" core
    # Zig also records the build-local wlroots directory. The installed binary
    # must resolve the packaged private library without retaining worker paths.
    local binary="$pkgdir/usr/bin/aqueous"
    patchelf --set-rpath '$ORIGIN/../lib/aqueous' "$binary"
    if [[ "$(patchelf --print-rpath "$binary")" != '$ORIGIN/../lib/aqueous' ]]; then
        error "installed compositor has an unexpected private-library search path"
        return 1
    fi
}

package_aqueous-session-git() {
    pkgdesc='Aqueous login session and shell-neutral desktop configuration'
    arch=('any')
    depends=("aqueous-core-git=$pkgver-$pkgrel" "bash" "jq" "coreutils" "uwsm" "dbus" "systemd" "ghostty" "grim" "slurp" "wl-clipboard" "libnotify" "xdg-desktop-portal")
    provides=("aqueous-session=$pkgver-$pkgrel")
    conflicts=('aqueous-session' 'aqueous-welcome-git' 'aqueous-git<1.0.2.r6' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-session-bin' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
    backup=('etc/xdg/aqueous/wm.toml' 'etc/xdg/aqueous/outputs.toml' 'etc/xdg/uwsm/env-aqueous' 'etc/xdg/menus/aqueous-applications.menu' 'etc/xdg/xdg-desktop-portal-aqueous/config')
    DESTDIR="$pkgdir" PREFIX=/usr bash "$srcdir/aqueous/packaging/stage-component.sh" session
    # Pearl Git remains a separate package with its own command/service names.
    sed -i -e 's/^pearl_binary=pearl$/pearl_binary=pearl-git/' \
        -e 's/^pearl_control=pearlctl$/pearl_control=pearlctl-git/' \
        -e 's|/lib/pearl/pearl-capture-picker|/lib/pearl-git/pearl-capture-picker|g' \
        -e 's/Pearl:/Pearl-Git:/g' \
        -e 's/xdg-desktop-portal-pearl\.service/xdg-desktop-portal-pearl-git.service/g' \
        "$pkgdir/usr/lib/aqueous/session-runtime.sh"
}

package_aqueous-integration-pearl-git() {
    pkgdesc='Pearl shell integration for the Aqueous session'
    arch=('any')
    depends=("aqueous-session-git=$pkgver-$pkgrel")
    provides=("aqueous-integration-pearl=$pkgver-$pkgrel")
    conflicts=('aqueous-integration-pearl' 'aqueous-git<1.0.2.r6' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-integration-pearl-bin' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
    DESTDIR="$pkgdir" PREFIX=/usr bash "$srcdir/aqueous/packaging/stage-component.sh" integration-pearl
    sed -i 's|/usr/bin/pearl$|/usr/bin/pearl-git|' \
        "$pkgdir/usr/lib/systemd/user/aqueous-pearl.service"
    mv "$pkgdir/usr/lib/systemd/user/pearl.service.d" \
        "$pkgdir/usr/lib/systemd/user/pearl-git.service.d"
}

package_aqueous-shell-pearl-git() {
    pkgdesc='Pearl shell dependency preset for Aqueous'
    arch=('any')
    depends=("pearl-capture-picker>=1" "xdg-desktop-portal-aqueous-git=$pkgver-$pkgrel" "aqueous-integration-pearl-git=$pkgver-$pkgrel" "pearl-git")
    provides=("aqueous-shell-pearl=$pkgver-$pkgrel")
    conflicts=('aqueous-shell-pearl' 'aqueous-git<1.0.2.r6' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-shell-pearl-bin')
    : # Dependency-only preset; devario-desktop-git owns the session selection.
}

package_xdg-desktop-portal-aqueous-git() {
    pkgdesc='Aqueous screen-sharing portal and standalone GTK source picker'
    depends=("gtk4" "libinih" "pipewire" "wayland" "systemd-libs" "xdg-desktop-portal")
    provides=("xdg-desktop-portal-aqueous=$pkgver-$pkgrel")
    conflicts=('xdg-desktop-portal-aqueous' 'aqueous-git<1.0.2.r6' 'aqueous-git-intel' 'aqueous-git-dms' 'xdg-desktop-portal-aqueous-bin' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
    AQUEOUS_PICKER_BINARY="$srcdir/aqueous-picker-dist/bin/aqueous-portal-picker" \
    AQUEOUS_PORTAL_BINARY="$srcdir/aqueous-portal-dist/usr/lib/aqueous/xdg-desktop-portal-aqueous" \
    AQUEOUS_PORTAL_LICENSE="$srcdir/xdg-desktop-portal-wlr-0.8.4/LICENSE" \
        DESTDIR="$pkgdir" PREFIX=/usr bash "$srcdir/aqueous/packaging/stage-component.sh" portal
}

package_devario-desktop-git() {
    pkgdesc='Devario desktop with Aqueous Git, Pearl Git and Pearl Greeter'
    arch=('any')
    license=('GPL-3.0-only')
    depends=("aqueous-core-git>=$pkgver-$pkgrel" "aqueous-session-git>=$pkgver-$pkgrel"
             "xdg-desktop-portal-aqueous-git>=$pkgver-$pkgrel"
             "aqueous-integration-pearl-git>=$pkgver-$pkgrel" "aqueous-shell-pearl-git>=$pkgver-$pkgrel"
             'pearl-git' 'pearl-greeter' 'rtkit')
    # Stable is an explicit installation choice; only retired Git presets are
    # automatically renamed during a repository upgrade.
    provides=("devario-desktop=$pkgver-$pkgrel" "aqueous-desktop-git=$pkgver-$pkgrel" "aqueous-git=$pkgver-$pkgrel")
    conflicts=('devario-desktop' 'aqueous-desktop' 'devario-aqueous-desktop' 'aqueous-desktop-git' 'aqueous-git')
    replaces=('aqueous-desktop-git' 'aqueous-git')
    backup=('etc/xdg/aqueous/session.toml')
    install -Dm644 "$srcdir/session.toml" "$pkgdir/etc/xdg/aqueous/session.toml"
}
