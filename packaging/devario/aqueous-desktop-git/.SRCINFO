	conflicts = aqueous-git<1.0.2.r6
	conflicts = aqueous-git-intel
	conflicts = aqueous-git-dms
	conflicts = aqueous-session-bin
	conflicts = aqueous<0.7.0-2
	conflicts = aqueous-bin<0.7.0-2
