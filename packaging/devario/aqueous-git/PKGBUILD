# Maintainer: Devario maintainers
pkgbase=aqueous-git
pkgname=(aqueous-core-git aqueous-session-git xdg-desktop-portal-aqueous-git
         aqueous-integration-pearl-git aqueous-shell-pearl-git aqueous-git)
_channel=git
pkgver=1.0.2.r8.gab632f2b
pkgrel=1
pkgdesc='Devario Pearl desktop with Aqueous Git (co-installable with stable)'
arch=('x86_64' 'aarch64')
url='https://github.com/Seafoam-Labs/Aqueous'
license=('GPL-3.0-only' 'MIT')
options=('!strip' '!debug' '!zipman')
makedepends=('patchelf' 'git' 'curl' 'patch' 'scdoc' 'jq' 'python' 'shaderc' 'clang' 'lld' 'llvm'
             'wayland-protocols>=1.49' 'pkgconf' 'meson' 'ninja' 'glslang'
             'vulkan-headers' 'hwdata' 'zig=0.16.0' 'libinih' 'freetype2' 'wayland'
             'libxkbcommon' 'libinput' 'pixman' 'libpng' 'libdrm' 'libevdev' 'libdecor'
             'xorg-xwayland' 'pipewire' 'glib2' 'fontconfig' 'mesa' 'systemd-libs'
             'seatd' 'libdisplay-info' 'libliftoff' 'lcms2' 'vulkan-icd-loader'
             'libxcb' 'xcb-util-errors' 'xcb-util-wm' 'xcb-util-renderutil')
checkdepends=('jq' 'ripgrep' 'gsettings-desktop-schemas')
source=('session.toml'
        "aqueous::git+${url}.git"
        'wlroots-0.20.2.tar.gz::https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/0.20.2/wlroots-0.20.2.tar.gz'
        'xdg-desktop-portal-wlr-0.8.4.tar.gz::https://github.com/emersion/xdg-desktop-portal-wlr/archive/refs/tags/v0.8.4.tar.gz')
sha256sums=('2cecdd6b68deaedc81997669b26ddfb705c458c8de9d8fdd465aaae35eba845b'
            'SKIP' '972c7ac44b17828f4702bfae7cd8347346a3fb5b2c1076cfa2c3fcedac5ec343'
            '3122966d46ab108f505525bcb2498f9121b446ee8438fbfceb73a7a1fa1ad400')
pkgver() {
    cd "$srcdir/aqueous"
    local version
    version=$(git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
    if [[ -z $version ]]; then version="1.0.3.r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"; fi
    printf '%s\n' "$version"
}
build() {
    srcdir="$srcdir" pkgver="$pkgver" bash "$srcdir/aqueous/packaging/git/build.sh" build "$_channel"
    srcdir="$srcdir" pkgver="$pkgver" bash "$srcdir/aqueous/packaging/git/desktop-build.sh" build "$_channel"
}
check() {
    srcdir="$srcdir" pkgver="$pkgver" bash "$srcdir/aqueous/packaging/git/build.sh" check "$_channel"
    srcdir="$srcdir" pkgver="$pkgver" bash "$srcdir/aqueous/packaging/git/desktop-build.sh" check "$_channel"
}
_stage_core() {
    srcdir="$srcdir" pkgdir="$pkgdir" pkgver="$pkgver" bash "$srcdir/aqueous/packaging/git/build.sh" package "$_channel"
}
_stage() {
    srcdir="$srcdir" pkgdir="$pkgdir" pkgver="$pkgver" bash "$srcdir/aqueous/packaging/git/desktop-build.sh" package "$_channel" "$1"
}
package_aqueous-core-git() {
    pkgdesc='Aqueous development compositor, helper and control client (co-installable with stable)'
    license=('GPL-3.0-only' 'MIT' '0BSD' 'CC-BY-SA-4.0')
    depends=('bash' 'freetype2' 'wayland' 'libxkbcommon' 'libinput' 'pixman' 'libpng'
             'libdrm' 'libevdev' 'libdecor' 'xorg-xwayland' 'pipewire' 'glib2' 'fontconfig'
             'mesa' 'systemd-libs' 'seatd' 'libdisplay-info' 'libliftoff' 'lcms2'
             'vulkan-icd-loader' 'libxcb' 'xcb-util-errors' 'xcb-util-wm' 'xcb-util-renderutil'
             'brightnessctl' 'playerctl')
    _stage_core
    local binary="$pkgdir/usr/lib/aqueous-git/bin/aqueous"
    patchelf --set-rpath '$ORIGIN/../lib/aqueous' "$binary"
    [[ $(patchelf --print-rpath "$binary") == '$ORIGIN/../lib/aqueous' ]] || return 1
}
package_aqueous-session-git() {
    arch=('any')
    pkgdesc='Aqueous Git login session and runtime'
    # Remove the obsolete worker/autostart package when upgrading the session.
    conflicts=('aqueous-welcome-git')
    depends=("aqueous-core-$_channel=$pkgver-$pkgrel" 'bash' 'jq' 'coreutils' 'uwsm' 'dbus' 'systemd'
             'ghostty' 'grim' 'slurp' 'wl-clipboard' 'libnotify' 'xdg-desktop-portal')
    backup=('etc/xdg/aqueous-git/wm.toml' 'etc/xdg/aqueous-git/outputs.toml'
            'etc/xdg/uwsm/env-aqueous-git' 'etc/xdg/menus/aqueous-git-applications.menu'
            'etc/xdg/xdg-desktop-portal-aqueous-git/config')
    _stage session
}
package_xdg-desktop-portal-aqueous-git() {
    pkgdesc='Aqueous Git screen capture portal'
    depends=('libinih' 'pipewire' 'wayland' 'systemd-libs' 'libdrm' 'mesa' 'xdg-desktop-portal')
    _stage portal
}
package_aqueous-integration-pearl-git() {
    arch=('any')
    pkgdesc='Pearl integration for Aqueous Git'
    depends=("aqueous-session-$_channel=$pkgver-$pkgrel")
    _stage integration-pearl
}
package_aqueous-shell-pearl-git() {
    arch=('any')
    pkgdesc='Optional Pearl shell preset for Aqueous Git'
    depends=("pearl-capture-picker-git>=1" "xdg-desktop-portal-aqueous-git=$pkgver-$pkgrel" "aqueous-integration-pearl-$_channel=$pkgver-$pkgrel" 'pearl-git')
}
package_aqueous-git() {
    pkgdesc='Devario Pearl desktop with Aqueous Git and Pearl Greeter'
    arch=('any')
    replaces=('aqueous-desktop-git')
    conflicts=('aqueous-desktop-git')
    provides=("aqueous-desktop-git=$pkgver-$pkgrel")
    depends=("aqueous-core-git=$pkgver-$pkgrel" "aqueous-session-git=$pkgver-$pkgrel"
             "xdg-desktop-portal-aqueous-git=$pkgver-$pkgrel"
             "aqueous-integration-pearl-git=$pkgver-$pkgrel" "aqueous-shell-pearl-git=$pkgver-$pkgrel"
             'pearl-git' 'pearl-greeter')
    backup=('etc/xdg/aqueous-git/session.toml')
    install -Dm644 "$srcdir/session.toml" "$pkgdir/etc/xdg/aqueous-git/session.toml"
}
