# Maintainer: Devario maintainers
# Standalone component from the same release as the upstream split packages.
pkgname=aqueous-integration-pearl
pkgver=1.0.0
pkgrel=2
pkgdesc='Pearl shell integration for the Aqueous session'
arch=('any')
url='https://github.com/Seafoam-Labs/Aqueous'
license=('GPL-3.0-only' 'MIT')
depends=("aqueous-session=$pkgver-$pkgrel")
conflicts=('aqueous-git' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-integration-pearl-bin' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
makedepends=('git')
options=('!debug' '!strip')
source=("aqueous::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

package() {
    DESTDIR="$pkgdir" PREFIX=/usr bash "$srcdir/aqueous/packaging/stage-component.sh" integration-pearl
}
