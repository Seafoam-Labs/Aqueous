# Maintainer: Devario maintainers
# Standalone component from the same release as the upstream split packages.
pkgname=xdg-desktop-portal-aqueous
pkgver=1.0.0
pkgrel=1
pkgdesc='Aqueous screen-sharing portal and standalone GTK source picker'
arch=('x86_64' 'aarch64')
url='https://github.com/Seafoam-Labs/Aqueous'
license=('GPL-3.0-only' 'MIT')
depends=("gtk4" "libinih" "pipewire" "wayland" "systemd-libs" "xdg-desktop-portal")
conflicts=('aqueous-git' 'aqueous-git-intel' 'aqueous-git-dms' 'xdg-desktop-portal-aqueous-bin' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
makedepends=('git' 'patch' 'meson' 'ninja' 'pkgconf' 'wayland-protocols>=1.49' 'zig=0.16.0')
checkdepends=('python')
options=('!strip' '!debug')
source=("aqueous::git+${url}.git#tag=v${pkgver}"
        'xdg-desktop-portal-wlr-0.8.4.tar.gz::https://github.com/emersion/xdg-desktop-portal-wlr/archive/refs/tags/v0.8.4.tar.gz')
sha256sums=('SKIP' '3122966d46ab108f505525bcb2498f9121b446ee8438fbfceb73a7a1fa1ad400')

prepare() {
    patch --fuzz=0 -d "$srcdir/xdg-desktop-portal-wlr-0.8.4" -Np1 \
        -i "$srcdir/aqueous/packaging/portal/0001-rename-backend-for-aqueous.patch"
}

build() {
    # x86-64-v3 is shared by supported Intel and AMD CPUs; ARM stays baseline.
    case ${CARCH:-$(uname -m)} in
        x86_64)
            AQUEOUS_ZIG_CPU=x86_64_v3
            export CFLAGS="${CFLAGS:+$CFLAGS }-march=x86-64-v3 -mtune=generic"
            export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-march=x86-64-v3 -mtune=generic"
            ;;
        aarch64) AQUEOUS_ZIG_CPU=baseline ;;
        *) printf 'Unsupported package architecture: %s\n' "${CARCH:-$(uname -m)}" >&2; return 1 ;;
    esac
    # This target builds the screen-sharing picker without the Welcome app.
    ZIG_GLOBAL_CACHE_DIR="$srcdir/aqueous-picker-zig-global" \
    ZIG_LOCAL_CACHE_DIR="$srcdir/aqueous-picker-zig-local" \
        zig build --build-file "$srcdir/aqueous/welcome/build.zig" picker \
        -Dcpu="$AQUEOUS_ZIG_CPU" -Doptimize=ReleaseSafe --prefix "$srcdir/aqueous-picker-dist"
    sh "$srcdir/aqueous/packaging/portal/build-aqueous-portal.sh" \
        "$srcdir/xdg-desktop-portal-wlr-0.8.4" \
        "$srcdir/aqueous-portal-build" "$srcdir/aqueous-portal-dist"
}

check() {
    test -x "$srcdir/aqueous-picker-dist/bin/aqueous-portal-picker"
    test ! -e "$srcdir/aqueous-picker-dist/bin/aqueous-welcome"
    bash "$srcdir/aqueous/packaging/tests/test-portal-packaging.sh" \
        "$srcdir/aqueous-portal-dist/usr/lib/aqueous/xdg-desktop-portal-aqueous"
}

package() {
    AQUEOUS_PICKER_BINARY="$srcdir/aqueous-picker-dist/bin/aqueous-portal-picker" \
    AQUEOUS_PORTAL_BINARY="$srcdir/aqueous-portal-dist/usr/lib/aqueous/xdg-desktop-portal-aqueous" \
    AQUEOUS_PORTAL_LICENSE="$srcdir/xdg-desktop-portal-wlr-0.8.4/LICENSE" \
        DESTDIR="$pkgdir" PREFIX=/usr bash "$srcdir/aqueous/packaging/stage-component.sh" portal
}
