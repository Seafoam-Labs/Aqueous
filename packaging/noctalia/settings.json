{
  "_comment": "Aqueous default Noctalia config. Seeded to ~/.config/noctalia/settings.json on first launch by aqueous-init when no user config exists. Never overwritten afterwards.",

  "general": {
    "allowPasswordWithFprintd": false,
    "compactLockScreen": false,
    "dimmerOpacity": 0.2,
    "enableBlurBehind": true,
    "enableLockScreenCountdown": true,
    "enableLockScreenMediaControls": true
  },

  "idle": {
    "enabled": true,
    "fadeDuration": 5,
    "lockCommand": "",
    "lockTimeout": 300,
    "resumeLockCommand": "",
    "resumeScreenOffCommand": "wlr-randr --output \"*\" --on",
    "resumeSuspendCommand": "",
    "screenOffCommand": "wlr-randr --output \"*\" --off",
    "screenOffTimeout": 600,
    "suspendCommand": "systemctl suspend",
    "suspendTimeout": 1800,
    "customCommands": "[]"
  },

  "wallpaper": {
    "enabled": true,
    "directory": "/usr/share/aqueous/wallpapers",
    "fillMode": "fit",
    "fillColor": "#000000",
    "solidColor": "#1a1a2e",
    "useSolidColor": false,
    "setWallpaperOnAllMonitors": true,
    "randomIntervalSec": 300,
    "wallpaperChangeMode": "random",
    "sortOrder": "date_desc",
    "transitionDuration": 1500,
    "transitionType": ["fade", "disc", "stripes", "wipe"]
  }
}
