#!/bin/sh
# Aqueous init wrapper.
#
# Installed as /usr/bin/aqueous-init and run by RiverDelta as its `-c` child:
#
#     exec riverdelta -c '/usr/bin/aqueous-init'
#
# Why this wrapper exists:
#
#   1. RiverDelta's `-c` only accepts ONE command. We need to call multiple
#      programs inside RiverDelta's control context (the only place where
#      WAYLAND_DISPLAY is set and `wlr-randr` actually work).
#
#   2. greetd performs no DRM mode setup of its own — it simply exec's
#      this session script. Under SDDM the kernel/DRM had a sane mode
#      pre-picked; under greetd we have to apply the persisted output
#      configuration *before* Aqueous draws its first frame, otherwise
#      the screen comes up at the connector's preferred mode and there
#      is no opportunity to renegotiate it from a Wayland client.
#
# Phase 1 — apply once, blocking, before Aqueous starts.
# Phase 2 — fork the long-running daemon for live changes from Aqueous
#           and Noctalia.
# Phase 3 — exec Aqueous.
set -u
LOG="${XDG_RUNTIME_DIR:-/tmp}/aqueous-outputd.log"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/aqueous/wm.toml"

# Seed Noctalia defaults on first launch. Idempotent and non-destructive:
# only runs when the user has no settings.json yet. Aqueous ships sensible
# defaults (idle/lock timeouts, blurred lock screen, default wallpapers
# pointing at /usr/share/aqueous/wallpapers).
NOCTALIA_USER_CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
NOCTALIA_DEFAULTS="/usr/share/aqueous/noctalia/settings.json"
if [ ! -e "$NOCTALIA_USER_CFG_DIR/settings.json" ] && [ -r "$NOCTALIA_DEFAULTS" ]; then
    mkdir -p "$NOCTALIA_USER_CFG_DIR"
    cp "$NOCTALIA_DEFAULTS" "$NOCTALIA_USER_CFG_DIR/settings.json"
    chmod 600 "$NOCTALIA_USER_CFG_DIR/settings.json"
fi

if [ -x /usr/bin/aqueous-outputd ]; then
    # apply-once is fire-and-forget. Never fatal: a bad output config
    # must not black out the session — fall through to Aqueous either way.
    /usr/bin/aqueous-outputd --apply-once --config "$CFG" >>"$LOG" 2>&1 || true

    # Skip the inline fork if a systemd user unit is already managing it.
    if ! systemctl --user is-active --quiet aqueous-outputd.service 2>/dev/null; then
        /usr/bin/aqueous-outputd --serve >>"$LOG" 2>&1 &
    fi
fi

# Push the (now-live) Wayland env into systemd --user + D-Bus so
# xdg-desktop-portal-gtk can actually connect to the compositor.
# Must run here, NOT in aqueous-wm.sh, because WAYLAND_DISPLAY only
# becomes valid once RiverDelta has exec'd us.
# The GPU-pin vars (MESA_VK_DEVICE_SELECT/__GLX_VENDOR_LIBRARY_NAME/DRI_PRIME/
# __NV_PRIME_RENDER_OFFLOAD) are set by RiverDelta on this process's environment
# only on multi-GPU systems (empty on single-GPU). Forwarding them in the bare
# KEY form means the tools silently skip any that are unset, so this is inert on
# single-GPU machines and pins .desktop/systemd-launched apps to the same GPU
# the compositor renders on, closing the last launch path that could straddle
# two GPU stacks (the dual-GPU GObject toggle-ref crash).
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP=Aqueous \
        XDG_SESSION_TYPE=wayland \
        XDG_RUNTIME_DIR \
        MESA_VK_DEVICE_SELECT \
        __GLX_VENDOR_LIBRARY_NAME \
        DRI_PRIME \
        __NV_PRIME_RENDER_OFFLOAD 2>/dev/null || true
elif command -v systemctl >/dev/null 2>&1; then
    # Only import vars that are actually set, so older systemd versions never
    # warn on unset names (keeps the single-GPU case clean).
    gpu_vars=""
    for v in MESA_VK_DEVICE_SELECT __GLX_VENDOR_LIBRARY_NAME DRI_PRIME __NV_PRIME_RENDER_OFFLOAD; do
        eval "val=\${$v:-}"
        [ -n "$val" ] && gpu_vars="$gpu_vars $v"
    done
    # shellcheck disable=SC2086
    systemctl --user import-environment \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR \
        $gpu_vars \
        2>/dev/null || true
fi

# Bring the graphical session up. xdg-desktop-portal.service has
# Requisite=graphical-session.target, so the portal cannot start until that
# target is active. graphical-session.target is static (RefuseManualStart),
# so we go through the aqueous-session.target wrapper that Requires/BindsTo
# it. Without this the portal restart below is doomed on a fresh boot and
# flameshot/screencast fail with "could not locate org.freedesktop.portal.Desktop".
systemctl --user start aqueous-session.target 2>/dev/null || true

# Kick the portal in case it already failed earlier in the boot.
# reset-failed clears the start-limit so the restart actually runs.
systemctl --user reset-failed xdg-desktop-portal-gtk.service 2>/dev/null || true
systemctl --user restart xdg-desktop-portal.service xdg-desktop-portal-gtk.service xdg-desktop-portal-wlr.service 2>/dev/null || true

exec /usr/bin/aqueous
