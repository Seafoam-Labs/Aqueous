+/* Inspect an isolated copy of the variant. Copying advances the caller past
+ * the whole variant; unknown or malformed restore data falls back to UI. */
+static char *read_restore_output(sd_bus_message *msg) {
+	const char *vendor, *signature, *key, *output = NULL;
+	uint32_t version;
+	char type;
+	if (sd_bus_message_peek_type(msg, &type, &signature) <= 0 || type != 'v' ||
+		strcmp(signature, "(suv)") != 0) return NULL;
+	if (sd_bus_message_enter_container(msg, 'v', "(suv)") <= 0 ||
+		sd_bus_message_enter_container(msg, 'r', "suv") <= 0 ||
+		sd_bus_message_read(msg, "su", &vendor, &version) <= 0 ||
+		strcmp(vendor, "wlroots") != 0 || version != XDP_CAST_DATA_VER) return NULL;
+	if (sd_bus_message_enter_container(msg, 'v', "a{sv}") <= 0 ||
+		sd_bus_message_enter_container(msg, 'a', "{sv}") <= 0) return NULL;
+	int ret;
+	while ((ret = sd_bus_message_enter_container(msg, 'e', "sv")) > 0) {
+		if (sd_bus_message_read(msg, "s", &key) <= 0) return NULL;
+		if (strcmp(key, "output_name") == 0) {
+			if (output || sd_bus_message_read(msg, "v", "s", &output) <= 0) return NULL;
+		} else if (sd_bus_message_skip(msg, "v") < 0) return NULL;
+		if (sd_bus_message_exit_container(msg) < 0) return NULL;
+	}
+	if (ret < 0 || !output || !*output || strlen(output) > 4096) return NULL;
+	return strdup(output);
+}
