+/* Aqueous dmenu requests stay on the event loop while the picker is running. */
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/prctl.h>
+#define CHOOSER_LIMIT (1024 * 1024)
+struct async_chooser {
+ struct xdpw_screencast_context *ctx;
+ struct xdpw_session *session;
+ sd_bus_message *message;
+ sd_bus_slot *request_slot, *owner_slot;
+ pid_t pid;
+ int input_fd, output_fd;
+ char *input, *output;
+ char *request_handle;
+ size_t input_len, sent, received;
+ uint32_t types;
+ bool cancelled;
+};
+void xdpw_chooser_cancel(void *data) {
+ struct async_chooser *job = data;
+ job->session = NULL;
+ job->cancelled = true;
+}
+static int chooser_close(sd_bus_message *msg, void *data, sd_bus_error *error) {
+ struct async_chooser *job = data;
+ if (strcmp(sd_bus_message_get_sender(msg), sd_bus_message_get_sender(job->message)))
+  return sd_bus_error_set_const(error, SD_BUS_ERROR_ACCESS_DENIED, "Request belongs to another sender");
+ job->cancelled = true;
+ logprint(DEBUG, "portal: chooser Request.Close session=%s", job->session ? job->session->session_handle : "closed");
+ return sd_bus_reply_method_return(msg, "");
+}
+static int chooser_owner(sd_bus_message *msg, void *data, sd_bus_error *error) {
+ (void)error;
+ struct async_chooser *job = data;
+ const char *name, *old, *next;
+ if (sd_bus_message_read(msg, "sss", &name, &old, &next) >= 0 && !*next &&
+     !strcmp(name, sd_bus_message_get_sender(job->message))) {
+  logprint(DEBUG, "portal: chooser owner lost request=%s", job->request_handle);
+  job->cancelled = true;
+ }
+ return 0;
+}
+static const sd_bus_vtable chooser_request[] = {
+ SD_BUS_VTABLE_START(0),
+ SD_BUS_METHOD("Close", "", "", chooser_close, SD_BUS_VTABLE_UNPRIVILEGED),
+ SD_BUS_VTABLE_END
+};
+static bool append_label(struct async_chooser *job, char *label) {
+ if (!label) return false;
+ size_t length = strlen(label);
+ if (length + 1 > CHOOSER_LIMIT - job->input_len) { free(label); return false; }
+ char *next = realloc(job->input, job->input_len + length + 1);
+ if (!next) { free(label); return false; }
+ job->input = next;
+ memcpy(next + job->input_len, label, length);
+ job->input_len += length;
+ next[job->input_len++] = '\n';
+ free(label);
+ return true;
+}
+static void chooser_finish(struct async_chooser *job, bool accepted) {
+ if (job->input_fd >= 0) close(job->input_fd);
+ if (job->output_fd >= 0) close(job->output_fd);
+ if (job->pid > 0) {
+  kill(-job->pid, SIGKILL);
+  while (waitpid(job->pid, NULL, 0) < 0 && errno == EINTR) {}
+ }
+ struct xdpw_screencast_target *target = NULL;
+ if (accepted && !job->cancelled && job->session && job->received > 0) {
+  /* Keep legacy dmenu support for one unterminated line; reject NUL/multiple lines. */
+  size_t length = job->received;
+  if (job->output[length - 1] == '\n') length--;
+  if (length && length <= CHOOSER_LIMIT &&
+      !memchr(job->output, '\0', length) && !memchr(job->output, '\n', length)) {
+   job->output[length] = '\0';
+   target = calloc(1, sizeof(*target));
+   if (target) {
+    struct xdpw_wlr_output *out;
+    if (job->types & MONITOR) wl_list_for_each(out, &job->ctx->output_list, link) {
+     char *label = get_output_label(out, XDPW_CHOOSER_DMENU);
+     bool equal = label && !strcmp(label, job->output); free(label);
+     if (equal) { target->type = MONITOR; target->output = out; break; }
+    }
+    struct xdpw_toplevel *top;
+    if (!target->output && (job->types & WINDOW)) wl_list_for_each(top, &job->ctx->toplevels, link) {
+     char *label = get_toplevel_label(top, XDPW_CHOOSER_DMENU);
+     bool equal = label && !strcmp(label, job->output); free(label);
+     if (equal) { target->type = WINDOW; target->toplevel = top; break; }
+    }
+    if (!target->output && !target->toplevel) { free(target); target = NULL; }
+   }
+  }
+ }
+ logprint(DEBUG, "portal: chooser finished request=%s session=%s selected=%s cancelled=%d",
+  job->request_handle ? job->request_handle : "unknown", job->session ? job->session->session_handle : "closed", target ? "yes" : "no", job->cancelled);
+ if (job->session) job->session->chooser = NULL;
+ sd_bus_slot_unref(job->request_slot);
+ sd_bus_slot_unref(job->owner_slot);
+ xdpw_start_done(job->ctx, job->session, target, job->message);
+ sd_bus_message_unref(job->message);
+ free(job->input); free(job->output); free(job->request_handle); free(job);
+}
+static void chooser_tick(void *data) {
+ struct async_chooser *job = data;
+ if (job->cancelled) { chooser_finish(job, false); return; }
+ if (job->input_fd >= 0) {
+  ssize_t n = write(job->input_fd, job->input + job->sent, job->input_len - job->sent);
+  if (n > 0) job->sent += n;
+  else if (n < 0 && errno != EAGAIN && errno != EINTR) { chooser_finish(job, false); return; }
+  if (job->sent == job->input_len) { close(job->input_fd); job->input_fd = -1; }
+ }
+ for (;;) {
+  if (job->received == CHOOSER_LIMIT + 1) { chooser_finish(job, false); return; }
+  ssize_t n = read(job->output_fd, job->output + job->received, CHOOSER_LIMIT + 1 - job->received);
+  if (n > 0) { job->received += n; continue; }
+  if (n < 0 && errno == EINTR) continue;
+  if (n < 0 && errno != EAGAIN) { chooser_finish(job, false); return; }
+  break;
+ }
+ int status;
+ pid_t result = waitpid(job->pid, &status, WNOHANG);
+ if (result == job->pid) {
+  /* Drain once more after exit, closing the race with the previous read. */
+  ssize_t n;
+  while (job->received < CHOOSER_LIMIT + 1 &&
+         (n = read(job->output_fd, job->output + job->received, CHOOSER_LIMIT + 1 - job->received)) > 0) job->received += n;
+  kill(-job->pid, SIGKILL); /* No descendant may retain a request pipe. */
+  job->pid = 0;
+  chooser_finish(job, WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  return;
+ }
+ if (result < 0 && errno != EINTR) { chooser_finish(job, false); return; }
+ if (!xdpw_add_timer(job->ctx->state, 20 * 1000 * 1000, chooser_tick, job)) chooser_finish(job, false);
+}
+int xdpw_chooser_async(struct xdpw_screencast_context *ctx, struct xdpw_session *session,
+ sd_bus_message *message, const char *handle, uint32_t types, const char *parent_window, const char *activation_token) {
+ struct async_chooser *job = calloc(1, sizeof(*job));
+ if (!job) return -ENOMEM;
+ job->ctx = ctx; job->session = session; job->message = sd_bus_message_ref(message);
+ job->input_fd = job->output_fd = -1; job->types = types & ctx->state->screencast_source_types;
+ job->output = malloc(CHOOSER_LIMIT + 1);
+ job->request_handle = strdup(handle);
+ if (!job->request_handle || !job->output || !ctx->state->config->screencast_conf.chooser_cmd) goto fail;
+ struct xdpw_wlr_output *out;
+ if (job->types & MONITOR) wl_list_for_each(out, &ctx->output_list, link)
+  if (!append_label(job, get_output_label(out, XDPW_CHOOSER_DMENU))) goto fail;
+ struct xdpw_toplevel *top;
+ if (job->types & WINDOW) wl_list_for_each(top, &ctx->toplevels, link)
+  if (!append_label(job, get_toplevel_label(top, XDPW_CHOOSER_DMENU))) goto fail;
+ if (!job->input_len) goto fail;
+ if (sd_bus_add_object_vtable(ctx->state->bus, &job->request_slot, handle,
+     "org.freedesktop.impl.portal.Request", chooser_request, job) < 0) goto fail;
+ if (sd_bus_match_signal(ctx->state->bus, &job->owner_slot, "org.freedesktop.DBus",
+     "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameOwnerChanged", chooser_owner, job) < 0) goto fail;
+ int in[2], output[2];
+ if (pipe2(in, O_CLOEXEC) < 0) goto fail;
+ if (pipe2(output, O_CLOEXEC) < 0) { close(in[0]); close(in[1]); goto fail; }
+ signal(SIGPIPE, SIG_IGN);
+ pid_t parent = getpid();
+ job->pid = fork();
+ if (job->pid == 0) {
+  setpgid(0, 0);
+  prctl(PR_SET_PDEATHSIG, SIGKILL);
+  if (getppid() != parent) _exit(1);
+  if (dup2(in[0], 0) < 0 || dup2(output[1], 1) < 0) _exit(1);
+  close(in[0]); close(in[1]); close(output[0]); close(output[1]);
+  /* Request metadata never goes through shell interpolation or stdout. */
+  if (setenv("AQUEOUS_PORTAL_PARENT_WINDOW", parent_window, 1) < 0) _exit(1);
+  unsetenv("DESKTOP_STARTUP_ID");
+  unsetenv("XDG_ACTIVATION_TOKEN");
+  if (*activation_token && setenv("XDG_ACTIVATION_TOKEN", activation_token, 1) < 0) _exit(1);
+  execl("/bin/sh", "sh", "-c", ctx->state->config->screencast_conf.chooser_cmd, NULL);
+  _exit(127);
+ }
+ close(in[0]); close(output[1]);
+ job->input_fd = in[1]; job->output_fd = output[0];
+ if (job->pid < 0) goto fail;
+ setpgid(job->pid, job->pid);
+ if (fcntl(job->input_fd, F_SETFL, O_NONBLOCK) < 0 || fcntl(job->output_fd, F_SETFL, O_NONBLOCK) < 0) goto fail;
+ logprint(DEBUG, "portal: chooser launched request=%s session=%s pid=%d", handle, session->session_handle, job->pid);
+ session->chooser = job;
+ if (!xdpw_add_timer(ctx->state, 1, chooser_tick, job)) goto fail;
+ return 1; /* Deferred method reply. */
+fail:
+ chooser_finish(job, false);
+ return 1;
+}
