+static uint32_t persist_limit(void) {
+	const char *mode = getenv("XDPW_PERSIST_MODE");
+	if (!mode || strcmp(mode, "transient") == 0) return PERSIST_TRANSIENT;
+	if (strcmp(mode, "permanent") == 0) return PERSIST_PERMANENT;
+	return PERSIST_NONE; /* An explicit disable or unknown override fails closed. */
+}
