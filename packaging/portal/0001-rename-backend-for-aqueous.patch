+			cast->ext_session.frame = NULL;
+		}
+	} else if (cast->ctx->screencopy_manager) {
+		xdpw_wlr_sc_session_close(cast);
+	}
+	cast->current_frame.completed = false;
+	cast->current_frame.damage.size = 0;
