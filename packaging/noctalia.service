[Unit]
Description=Noctalia shell (bar / SNI tray host)
PartOf=graphical-session.target
After=graphical-session.target
# Win the tray race: own org.kde.StatusNotifierWatcher before any autostart
# .desktop app (nm-applet, blueman-applet, udiskie, …) tries to
# RegisterStatusNotifierItem. Without this ordering the tray apps spawned by
# xdg-desktop-autostart.target register against a watcher that doesn't exist
# yet and drop their icons.
Before=xdg-desktop-autostart.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Aqueous

[Service]
# Noctalia v5 is the native C++/GLES shell. `--daemon` forks the shell into the
# background and the launcher process returns only once the shell (and its tray
# host) has initialised. Type=forking makes systemd wait for that return before
# marking the unit active, giving a genuine readiness barrier so
# Before=xdg-desktop-autostart.target actually holds the autostart target until
# the watcher is up, and tracks the surviving shell as MainPID (so the unit
# stays active and tears down cleanly with graphical-session.target).
Type=forking
ExecStart=/usr/bin/noctalia --daemon
# Register the system-owned Aqueous plugin once for this user. The helper
# writes a marker only after both source registration and enablement succeed,
# so failures retry next session while a later intentional disable is honored.
ExecStartPost=/usr/lib/aqueous/enable-noctalia-plugin
Restart=on-failure
RestartSec=2
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
