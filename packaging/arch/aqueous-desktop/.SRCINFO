pkgname = aqueous-session
	pkgdesc = Aqueous login session and shell-neutral desktop configuration
	arch = any
	depends = aqueous-core=1.0.5-3
	depends = bash
	depends = jq
	depends = coreutils
	depends = uwsm
	depends = dbus
	depends = systemd
	depends = ghostty
	depends = grim
	depends = slurp
	depends = wl-clipboard
	depends = libnotify
	depends = xdg-desktop-portal
