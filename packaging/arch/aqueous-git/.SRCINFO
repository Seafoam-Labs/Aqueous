pkgbase = aqueous-git
	pkgdesc = Aqueous Git compositor, desktop components and optional shell presets (co-installable with stable)
	pkgver = 1.0.13
	pkgrel = 1
	url = https://github.com/Seafoam-Labs/Aqueous
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	license = MIT
	checkdepends = jq
	checkdepends = ripgrep
	checkdepends = gsettings-desktop-schemas
	makedepends = git
	makedepends = curl
	makedepends = patch
	makedepends = scdoc
	makedepends = jq
	makedepends = python
	makedepends = shaderc
	makedepends = clang
	makedepends = lld
	makedepends = llvm
	makedepends = wayland-protocols>=1.49
	makedepends = pkgconf
	makedepends = meson
	makedepends = ninja
	makedepends = glslang
	makedepends = vulkan-headers
	makedepends = hwdata
	makedepends = zig=0.17.0
	makedepends = libinih
	makedepends = freetype2
	makedepends = wayland
	makedepends = libxkbcommon
	makedepends = libinput
	makedepends = pixman
	makedepends = libpng
	makedepends = libdrm
	makedepends = libevdev
	makedepends = libdecor
	makedepends = xorg-xwayland
	makedepends = pipewire
	makedepends = glib2
	makedepends = fontconfig
	makedepends = mesa
	makedepends = systemd-libs
	makedepends = seatd
	makedepends = libdisplay-info
	makedepends = libliftoff
	makedepends = lcms2
	makedepends = vulkan-icd-loader
	makedepends = libxcb
	makedepends = xcb-util-errors
	makedepends = xcb-util-wm
	makedepends = xcb-util-renderutil
	options = !strip
	options = !debug
	options = !zipman
	source = aqueous::git+https://github.com/Seafoam-Labs/Aqueous.git
	source = wlroots-0.20.2.tar.gz::https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/0.20.2/wlroots-0.20.2.tar.gz
	source = xdg-desktop-portal-wlr-0.8.4.tar.gz::https://github.com/emersion/xdg-desktop-portal-wlr/archive/refs/tags/v0.8.4.tar.gz
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = aqueous-core-git
	pkgdesc = Aqueous development compositor, helper and control client (co-installable with stable)
	license = GPL-3.0-only
	license = MIT
	license = 0BSD
	license = CC-BY-SA-4.0
	depends = bash
	depends = freetype2
	depends = wayland
	depends = libxkbcommon
	depends = libinput
	depends = pixman
	depends = libpng
	depends = libdrm
	depends = libevdev
	depends = libdecor
	depends = xorg-xwayland
	depends = pipewire
	depends = glib2
	depends = fontconfig
	depends = mesa
	depends = systemd-libs
	depends = seatd
	depends = libdisplay-info
	depends = libliftoff
	depends = lcms2
	depends = vulkan-icd-loader
	depends = libxcb
	depends = xcb-util-errors
	depends = xcb-util-wm
	depends = xcb-util-renderutil
	depends = brightnessctl
	depends = playerctl

pkgname = aqueous-shell-none-git
	pkgdesc = Shell-free Aqueous portal provider preset
	depends = aqueous-session-git=1.0.13-1
	depends = xdg-desktop-portal-gtk

pkgname = aqueous-session-git
	pkgdesc = Aqueous Git login session and runtime
	depends = aqueous-core-git=1.0.13-1
	depends = bash
	depends = jq
	depends = coreutils
	depends = uwsm
	depends = dbus
	depends = systemd
	depends = ghostty
	depends = grim
	depends = slurp
	depends = wl-clipboard
	depends = libnotify
	depends = xdg-desktop-portal
	conflicts = aqueous-welcome-git
	backup = etc/xdg/aqueous-git/wm.toml
	backup = etc/xdg/aqueous-git/outputs.toml
	backup = etc/xdg/uwsm/env-aqueous-git
	backup = etc/xdg/menus/aqueous-git-applications.menu
	backup = etc/xdg/xdg-desktop-portal-aqueous-git/config

pkgname = xdg-desktop-portal-aqueous-git
	pkgdesc = Aqueous Git screen capture portal
	depends = libinih
	depends = pipewire
	depends = wayland
	depends = systemd-libs
	depends = libdrm
	depends = mesa
	depends = xdg-desktop-portal

pkgname = aqueous-integration-dms-git
	pkgdesc = DMS integration for Aqueous Git
	depends = aqueous-session-git=1.0.13-1
	depends = xdg-desktop-portal-aqueous-git=1.0.13-1

pkgname = aqueous-integration-noctalia-git
	pkgdesc = Noctalia integration for Aqueous Git
	depends = aqueous-session-git=1.0.13-1

pkgname = aqueous-integration-pearl-git
	pkgdesc = Pearl integration for Aqueous Git
	depends = aqueous-session-git=1.0.13-1

pkgname = aqueous-shell-dms-git
	pkgdesc = Optional DMS shell preset for Aqueous Git
	depends = xdg-desktop-portal-gtk
	depends = aqueous-integration-dms-git=1.0.13-1
	depends = dms-shell

pkgname = aqueous-shell-noctalia-git
	pkgdesc = Optional Noctalia shell preset for Aqueous Git
	depends = xdg-desktop-portal-gtk
	depends = aqueous-integration-noctalia-git=1.0.13-1
	depends = noctalia

pkgname = aqueous-shell-pearl-git
	pkgdesc = Optional Pearl shell preset for Aqueous Git
	depends = pearl-capture-picker-git>=1
	depends = xdg-desktop-portal-aqueous-git=1.0.13-1
	depends = aqueous-integration-pearl-git=1.0.13-1
	depends = pearl-git

pkgname = aqueous-git
	pkgdesc = Aqueous Git desktop with optional shell presets
	depends = aqueous-shell-none-git=1.0.13-1
	depends = aqueous-core-git=1.0.13-1
	depends = aqueous-session-git=1.0.13-1
	depends = xdg-desktop-portal-aqueous-git=1.0.13-1
	depends = aqueous-integration-dms-git=1.0.13-1
	depends = aqueous-integration-noctalia-git=1.0.13-1
	depends = aqueous-integration-pearl-git=1.0.13-1
	provides = aqueous-desktop-git=1.0.13-1
	conflicts = aqueous-desktop-git
	replaces = aqueous-desktop-git
