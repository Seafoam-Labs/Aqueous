# =============================================================================
# Aqueous WM - window rules (example)
#
# Copy to ~/.config/aqueous/rules.toml to enable per-application placement
# (including game-mode). Missing file is fine - rules are simply disabled.
#
# Discovery order (first hit wins):
#   1. $AQUEOUS_RULES                        (env var, absolute path)
#   2. [rules].path in wm.toml               (override)
#   3. $XDG_CONFIG_HOME/aqueous/rules.toml
#   4. ~/.config/aqueous/rules.toml
#
# Reloaded by Super+R together with wm.toml. Bind `reload_rules` for rules-only
# reload (default unbound).
# =============================================================================

# -----------------------------------------------------------------------------
# Game-mode layout options. Only relevant when at least one [[window]] rule
# below targets layout = "game-mode". These keys USED TO live in wm.toml under
# [layout.options.game-mode]; that location is deprecated and Aqueous warns
# once on load. Two-release deprecation window.
# -----------------------------------------------------------------------------
[game_mode]
remainder_layout = "grid"    # tile | grid | monocle | scrolling | float
gaps_inner       = 8
fallback_layout  = "grid"    # used on outputs with no anchor

# -----------------------------------------------------------------------------
# Window rules. First match wins; rules are evaluated on manage_start and on
# every app_id / title change. At least one matcher (app_id / class / title)
# is required - matcher-less rules are dropped with a warning.
#
# Globs (`*`, `?`) are supported in matchers.
# -----------------------------------------------------------------------------

# Example: Dota 2 anchors centered at its requested resolution, with every
# other visible window tiled into one of the two full-height side columns
# flanking the anchor (round-robin: even index -> left, odd -> right).
# [[window]]
# app_id     = "dota2"
# layout     = "game-mode"
# anchor     = "center"        # center | top | bottom | left | right
# size       = "native"        # "native" | "WxH" | "FxF"
# scale      = 1.0
# tag        = 9               # optional - also move to this tag
# fullscreen = false
# ignore_struts = false        # if true, geometry ignores [struts] in wm.toml

# Example: force a specific size regardless of what the client asks for.
# [[window]]
# app_id = "cs2"
# layout = "game-mode"
# size   = "2560x1080"

# Example: let a window extend all the way to the edge of the output, ignoring
# the exclusion zone reserved for bars / panels by `[struts]` in wm.toml. When
# `ignore_struts = true`, the matched window's geometry is resolved against the
# raw output rect instead of the strut-shrunk usable area. Honoured by the
# fullscreen, maximized, game-mode anchor, scratchpad-summon, and default-float
# code paths. Other tiles on the same output continue to respect the struts.
# [[window]]
# app_id        = "obs"
# layout        = "game-mode"
# anchor        = "top"
# size          = "1920x1080"
# ignore_struts = true

# v1.5 NOTE: the space around the anchor is exposed as two full-height side
# columns (left of the anchor and right of the anchor). Non-anchor windows are
# partitioned round-robin across the two columns (even index -> left, odd ->
# right) and `remainder_layout` is invoked once per non-empty column with its
# own fresh instance. Top/bottom strips above and below the anchor are
# intentionally unused; column count is fixed at 2 (not configurable). If the
# anchor is flush against an edge, all non-anchor windows fall into the
# surviving column. File an issue if you need top/bottom strips or N > 2.
