<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- NativeAOT. AOT-friendly: no reflection, no dynamic codegen.
         Declared here so Rider and CI see the same publish profile as
         the PKGBUILD; the command line in PKGBUILD also passes
         -p:PublishAot=true defensively. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Analyzers are intentionally NOT enabled here yet; flip these
         on once IL2026/IL3050 warnings from Microsoft.Extensions.* are
         triaged. -->
    <!-- <EnableTrimAnalyzer>true</EnableTrimAnalyzer> -->
    <!-- <EnableAotAnalyzer>true</EnableAotAnalyzer> -->
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.0.1</Version>
    <AssemblyName>aqueous</AssemblyName>
    <AssemblyVersion>0.0.1</AssemblyVersion>
    <AssemblyTitle>aqueous</AssemblyTitle>
    <Description>A Window Manager with a focus on ultrawide (32:9) monitors</Description>
    <Company>Seafoam Labs</Company>
    <Product>Aqueoues Window Manager</Product>
    <Copyright>2026 Seafoam Labs</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>
</Project>
