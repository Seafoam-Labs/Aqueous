<?xml version="1.0" encoding="UTF-8"?>
<protocol name="aqueous_window_info_v1">
  <copyright>
    SPDX-FileCopyrightText: © 2026 Seafoam Labs
    SPDX-License-Identifier: MIT
  </copyright>

  <description summary="Aqueous window introspection and workspace layout control">
    This protocol augments ext_foreign_toplevel_handle_v1 with compositor
    policy information useful to diagnostics and window-rule authoring.

    Enumeration and stable identifiers remain owned by
    ext_foreign_toplevel_list_v1. Version 3 adds narrowly scoped control of the
    active workspace layout on a named output. Version 4 reports the window's
    committed wp_content_type_v1 state and content-type rule matchers. Version
    5 adds a read-only DRM overlay-plane diagnostic snapshot. Version 6 adds
    xdg-decoration negotiation state to window snapshots. Version 7 adds
    query and live control of the compositor-owned cursor theme.
  </description>

  <interface name="aqueous_window_info_manager_v1" version="7">
    <description summary="window information factory">
      Create a one-shot information snapshot for an Aqueous toplevel.
    </description>

    <enum name="error">
      <entry name="invalid_toplevel" value="0"
             summary="the foreign toplevel handle is not owned by Aqueous"/>
    </enum>

    <enum name="layout_status">
      <entry name="success" value="0"/>
      <entry name="output_not_found" value="1"/>
      <entry name="invalid_layout" value="2"/>
      <entry name="unavailable" value="3"/>
    </enum>

    <enum name="cursor_status">
      <entry name="success" value="0"/>
      <entry name="invalid_theme" value="1"/>
      <entry name="invalid_size" value="2"/>
      <entry name="load_failed" value="3"/>
      <entry name="environment_failed" value="4"/>
    </enum>

    <request name="get_window_info">
      <description summary="snapshot a foreign toplevel">
        The returned object receives all currently available properties followed
        by done. Properties without a meaningful value are omitted.
      </description>
      <arg name="id" type="new_id" interface="aqueous_window_info_v1"/>
      <arg name="toplevel" type="object" interface="ext_foreign_toplevel_handle_v1"/>
    </request>

    <request name="destroy" type="destructor">
      <description summary="destroy the manager proxy"/>
    </request>

    <request name="get_scene_snapshot" since="2">
      <description summary="snapshot the compositor scene graph">
        The returned object emits a stable, one-shot view of the current scene
        graph. Node identifiers are local to the snapshot and reveal no server
        pointers or other compositor-private identifiers.
      </description>
      <arg name="id" type="new_id" interface="aqueous_scene_snapshot_v1"/>
    </request>

    <request name="get_active_workspace_layout" since="3">
      <description summary="query the active workspace layout on an output"/>
      <arg name="output" type="string" summary="output connector name"/>
    </request>

    <request name="set_active_workspace_layout" since="3">
      <description summary="change the active workspace layout on an output">
        The layout change is applied immediately and remains a runtime override
        until the compositor exits.
      </description>
      <arg name="output" type="string" summary="output connector name"/>
      <arg name="layout" type="string"
           summary="tile, monocle, grid, rows, dwindle, reverse-dwindle, scrolling, float, game-mode, or composable"/>
    </request>

    <event name="active_workspace_layout" since="3">
      <description summary="result of a layout query or change"/>
      <arg name="status" type="uint" enum="layout_status"/>
      <arg name="output" type="string"/>
      <arg name="workspace" type="uint" summary="one-based active workspace, or zero"/>
      <arg name="layout" type="string" summary="effective layout, or empty on failure"/>
    </event>

    <request name="get_overlay_plane_snapshot" since="5">
      <description summary="snapshot per-output DRM overlay-plane state"/>
      <arg name="id" type="new_id" interface="aqueous_overlay_plane_snapshot_v1"/>
    </request>

    <request name="get_cursor_theme" since="7">
      <description summary="query the compositor-owned cursor theme"/>
    </request>

    <request name="set_cursor_theme" since="7">
      <description summary="change the compositor-owned cursor theme">
        Apply the theme immediately to every seat and make the selected values
        available to applications subsequently launched by Aqueous. Clients
        are responsible for updating systemd and D-Bus activation environments
        when they need launch paths outside Aqueous to inherit the values.
      </description>
      <arg name="name" type="string" summary="Xcursor theme name"/>
      <arg name="size" type="uint" summary="base cursor size in pixels"/>
    </request>

    <event name="cursor_theme" since="7">
      <description summary="result of a cursor query or change">
        Name and size always report the effective compositor configuration,
        including after a rejected change.
      </description>
      <arg name="status" type="uint" enum="cursor_status"/>
      <arg name="name" type="string"/>
      <arg name="size" type="uint"/>
    </event>
  </interface>

  <interface name="aqueous_window_info_v1" version="3">
    <description summary="one-shot window information snapshot">
      A read-only snapshot of compositor-owned state for one mapped toplevel.
      The state bitfield also reports stacking layer, snap, fixed-position,
      switcher, and taskbar policy without adding event opcodes.
    </description>

    <enum name="backend">
      <entry name="xdg" value="0" summary="native xdg-shell toplevel"/>
      <entry name="xwayland" value="1" summary="X11 toplevel through XWayland"/>
    </enum>

    <enum name="state" bitfield="true">
      <entry name="focused" value="1"/>
      <entry name="floating" value="2"/>
      <entry name="fullscreen" value="4"/>
      <entry name="maximized" value="8"/>
      <entry name="minimized" value="16"/>
      <entry name="visible" value="32"/>
      <entry name="always_above" value="64"/>
      <entry name="always_below" value="128"/>
      <entry name="snapped" value="256"/>
      <entry name="fixed_position" value="512"/>
      <entry name="skip_switcher" value="1024"/>
      <entry name="skip_taskbar" value="2048"/>
    </enum>

    <enum name="matcher">
      <entry name="app_id" value="0"/>
      <entry name="class" value="1"/>
      <entry name="title" value="2"/>
      <entry name="content_type" value="3" since="2"/>
    </enum>

    <enum name="decoration_capability">
      <entry name="unavailable" value="0"
             summary="the client has no xdg-decoration object"/>
      <entry name="xdg_decoration" value="1"
             summary="the client created an xdg-decoration object"/>
    </enum>

    <enum name="decoration_mode">
      <entry name="none" value="0"/>
      <entry name="client_side" value="1"/>
      <entry name="server_side" value="2"/>
    </enum>

    <event name="backend">
      <arg name="backend" type="uint" enum="backend"/>
    </event>

    <event name="app_id">
      <arg name="app_id" type="string"/>
    </event>

    <event name="class">
      <arg name="class" type="string"/>
    </event>

    <event name="output">
      <arg name="output" type="string"/>
    </event>

    <event name="workspace">
      <description summary="one-based workspace number"/>
      <arg name="workspace" type="uint"/>
    </event>

    <event name="geometry">
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </event>

    <event name="state">
      <arg name="state" type="uint" enum="state"/>
    </event>

    <event name="layout">
      <description summary="effective per-window placement mode"/>
      <arg name="layout" type="string"/>
    </event>

    <event name="content_type" since="2">
      <description summary="committed wp_content_type_v1 state">
        Omitted when the client has not committed a content type.
      </description>
      <arg name="content_type" type="uint"
           summary="zero none, one photo, two video, three game"/>
    </event>

    <event name="matched_rule">
      <description summary="one-based index in rules.toml"/>
      <arg name="index" type="uint"/>
    </event>

    <event name="decoration" since="3">
      <description summary="xdg-decoration negotiation state">
        requested is the client's latest preference. effective is the last
        mode committed through the xdg-decoration object. configure_pending is
        one when the client request still requires a compositor response.
      </description>
      <arg name="capability" type="uint" enum="decoration_capability"/>
      <arg name="requested" type="uint" enum="decoration_mode"/>
      <arg name="effective" type="uint" enum="decoration_mode"/>
      <arg name="configure_pending" type="uint"/>
    </event>

    <event name="rule_matcher">
      <description summary="a matcher belonging to the matched rule"/>
      <arg name="matcher" type="uint" enum="matcher"/>
      <arg name="pattern" type="string"/>
    </event>

    <event name="done">
      <description summary="the complete snapshot has been sent"/>
    </event>

    <request name="destroy" type="destructor">
      <description summary="destroy this snapshot object"/>
    </request>
  </interface>

  <interface name="aqueous_scene_snapshot_v1" version="1">
    <description summary="one-shot compositor scene graph snapshot">
      A read-only, pre-order snapshot of the wlroots scene graph. Parent zero
      identifies the root. Positions are relative to the parent node.
    </description>

    <enum name="node_type">
      <entry name="tree" value="0"/>
      <entry name="rect" value="1"/>
      <entry name="buffer" value="2"/>
    </enum>

    <event name="node">
      <description summary="one scene node">
        Nodes are emitted in render order. Width and height are zero for tree
        nodes and for buffers without a current destination size.
      </description>
      <arg name="id" type="uint" summary="snapshot-local node identifier"/>
      <arg name="parent" type="uint" summary="parent identifier, or zero for the root"/>
      <arg name="label" type="string" summary="human-readable semantic label"/>
      <arg name="node_type" type="uint" enum="node_type"/>
      <arg name="enabled" type="uint" summary="one when locally enabled"/>
      <arg name="x" type="int" summary="parent-relative x position"/>
      <arg name="y" type="int" summary="parent-relative y position"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </event>

    <event name="done">
      <description summary="the complete scene snapshot has been sent"/>
    </event>

    <request name="destroy" type="destructor">
      <description summary="destroy this snapshot object"/>
    </request>
  </interface>

  <interface name="aqueous_overlay_plane_snapshot_v1" version="1">
    <description summary="one-shot DRM overlay-plane diagnostic snapshot">
      One state and one counters event are emitted for each output, followed by
      done. 64-bit values are carried as high and low 32-bit words.
    </description>

    <enum name="capability">
      <entry name="unknown" value="0"/>
      <entry name="available" value="1"/>
      <entry name="unavailable" value="2"/>
    </enum>

    <enum name="phase">
      <entry name="disabled" value="0"/>
      <entry name="unavailable" value="1"/>
      <entry name="idle" value="2"/>
      <entry name="testing" value="3"/>
      <entry name="promoted" value="4"/>
      <entry name="backed_off" value="5"/>
      <entry name="fallback" value="6"/>
    </enum>

    <enum name="rejection_reason">
      <entry name="none" value="0"/>
      <entry name="globally_disabled" value="1"/>
      <entry name="backend_unavailable" value="2"/>
      <entry name="no_candidate" value="3"/>
      <entry name="candidate_destroyed" value="4"/>
      <entry name="not_visible" value="5"/>
      <entry name="not_opaque" value="6"/>
      <entry name="transformed" value="7"/>
      <entry name="scaled" value="8"/>
      <entry name="clipped" value="9"/>
      <entry name="effects_active" value="10"/>
      <entry name="intersected" value="11"/>
      <entry name="capture_active" value="12"/>
      <entry name="session_locked" value="13"/>
      <entry name="session_inactive" value="14"/>
      <entry name="software_cursor" value="15"/>
      <entry name="no_dmabuf" value="16"/>
      <entry name="explicit_sync_unavailable" value="17"/>
      <entry name="backend_test_rejected" value="18"/>
      <entry name="promoted_commit_failed" value="19"/>
    </enum>

    <event name="output_state">
      <arg name="output" type="string"/>
      <arg name="enabled" type="uint"/>
      <arg name="capability" type="uint" enum="capability"/>
      <arg name="phase" type="uint" enum="phase"/>
      <arg name="rejection_reason" type="uint" enum="rejection_reason"/>
      <arg name="candidate_hi" type="uint"/>
      <arg name="candidate_lo" type="uint"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
      <arg name="format" type="uint" summary="DRM fourcc, or zero"/>
      <arg name="modifier_hi" type="uint"/>
      <arg name="modifier_lo" type="uint"/>
      <arg name="backoff_ms" type="uint"/>
    </event>

    <event name="output_counters">
      <arg name="output" type="string"/>
      <arg name="attempts_hi" type="uint"/>
      <arg name="attempts_lo" type="uint"/>
      <arg name="accepted_hi" type="uint"/>
      <arg name="accepted_lo" type="uint"/>
      <arg name="rejected_hi" type="uint"/>
      <arg name="rejected_lo" type="uint"/>
      <arg name="backoff_skips_hi" type="uint"/>
      <arg name="backoff_skips_lo" type="uint"/>
      <arg name="fallback_hi" type="uint"/>
      <arg name="fallback_lo" type="uint"/>
      <arg name="promotions_hi" type="uint"/>
      <arg name="promotions_lo" type="uint"/>
      <arg name="demotions_hi" type="uint"/>
      <arg name="demotions_lo" type="uint"/>
    </event>

    <event name="done"/>

    <request name="destroy" type="destructor"/>
  </interface>
</protocol>
