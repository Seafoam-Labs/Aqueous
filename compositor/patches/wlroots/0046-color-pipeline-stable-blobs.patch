+/* Takes ownership of contents. Returns the colorop's DATA blob for these exact
+ * contents, creating it only when they differ from the last programmed data. */
+static bool node_data_blob(int fd, struct colorop *node, void *contents, size_t size,
+	uint32_t *blob) {
+	if (node->data_blob && node->data_size == size &&
+		memcmp(node->data_contents, contents, size) == 0) {
+		free(contents);
+		*blob = node->data_blob;
+		return true;
+	}
+	uint32_t created = 0;
+	if (drmModeCreatePropertyBlob(fd, contents, size, &created) != 0) {
+		free(contents);
+		return false;
+	}
+	/* The previous blob may still be committed; KMS holds its own reference. */
+	if (node->data_blob) {
+		drmModeDestroyPropertyBlob(fd, node->data_blob);
+	}
+	free(node->data_contents);
+	node->data_blob = created;
+	node->data_contents = contents;
+	node->data_size = size;
+	*blob = created;
+	return true;
+}
