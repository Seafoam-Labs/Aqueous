scene: carry the Windows-scRGB flag on the scene buffer

The fixed 80 cd/m² stimulus mapping for Windows-scRGB was chosen by
looking up the buffer's scene surface. Snapshot clones made for
animations have no surface, so on HDR outputs they took the SDR white
level gain instead (about 2.5x brighter at the default 200 cd/m²), and
the window went brighter for the length of an animation.

Store the flag on wlr_scene_buffer, set it from the surface image
description, and expose a setter/getter so compositors can copy it into
snapshots.

--- a/include/wlr/types/wlr_scene.h
+++ b/include/wlr/types/wlr_scene.h
@@ -233,6 +233,10 @@ struct wlr_scene_buffer {
 	enum wlr_color_encoding color_encoding;
 	enum wlr_color_range color_range;
 	bool force_blend;
+	// Predefined Windows-scRGB content (1.0 = 80 cd/m², client-managed HDR).
+	// Carried on the buffer so snapshots keep the fixed stimulus mapping after
+	// they lose access to the source surface.
+	bool windows_scrgb;
 
 	struct {
 		uint64_t active_outputs;
@@ -622,6 +626,16 @@ void wlr_scene_buffer_set_opaque_region(struct wlr_scene_buffer *scene_buffer,
 void wlr_scene_buffer_set_force_blend(struct wlr_scene_buffer *scene_buffer,
 	int force_blend);
 
+/**
+ * Mark the buffer as predefined Windows-scRGB content (1.0 = 80 cd/m²), which
+ * bypasses the SDR white level on HDR outputs. Set automatically for surface
+ * buffers; compositors copying a buffer into a snapshot must copy it too.
+ */
+void wlr_scene_buffer_set_windows_scrgb(struct wlr_scene_buffer *scene_buffer,
+	int windows_scrgb);
+
+bool wlr_scene_buffer_get_windows_scrgb(const struct wlr_scene_buffer *scene_buffer);
+
 /**
  * Set the source rectangle describing the region of the buffer which will be
  * sampled to render this node. This allows cropping the buffer.

