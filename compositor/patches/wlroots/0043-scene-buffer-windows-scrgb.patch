+++ b/types/scene/surface.c
@@ -387,6 +387,8 @@ static void surface_reconfigure(struct wlr_scene_surface *scene_surface) {
 	wlr_scene_buffer_set_primaries(scene_buffer, primaries);
 	wlr_scene_buffer_set_color_encoding(scene_buffer, color_encoding);
 	wlr_scene_buffer_set_color_range(scene_buffer, color_range);
+	wlr_scene_buffer_set_windows_scrgb(scene_buffer,
+		img_desc != NULL && img_desc->kind == WLR_IMAGE_DESCRIPTION_V1_WINDOWS_SCRGB);
 
 	scene_buffer_unmark_client_buffer(scene_buffer);
 

--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -1184,6 +1184,20 @@ void wlr_scene_buffer_set_force_blend(struct wlr_scene_buffer *scene_buffer,
 	scene_node_update(&scene_buffer->node, NULL);
 }
 
+void wlr_scene_buffer_set_windows_scrgb(struct wlr_scene_buffer *scene_buffer,
+		int windows_scrgb) {
+	if (scene_buffer->windows_scrgb == (windows_scrgb != 0)) {
+		return;
+	}
+
+	scene_buffer->windows_scrgb = windows_scrgb != 0;
+	scene_node_update(&scene_buffer->node, NULL);
+}
+
+bool wlr_scene_buffer_get_windows_scrgb(const struct wlr_scene_buffer *scene_buffer) {
+	return scene_buffer->windows_scrgb;
+}
