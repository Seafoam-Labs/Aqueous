From: Aqueous maintainers
Subject: [PATCH] vulkan: enumerate hardware candidates before software

Keep each physical device/ICD as a distinct candidate. Honor explicit render
node and software restrictions, and retain the backend/first accessible DRM
node preference. Failed renderer creation advances instead of masking the
remaining hardware. Share an instance safely across candidates and renderers;
allow recovery to recreate the selected physical device without re-selection.
The compositor validates effects, allocation and initial commits before
accepting a candidate. Synchronous SDR copy is a supported failure path.

diff --git a/include/render/vulkan.h b/include/render/vulkan.h
--- a/include/render/vulkan.h
+++ b/include/render/vulkan.h
@@ -18,6 +18,7 @@
 struct wlr_vk_texture;
 
 struct wlr_vk_instance {
+	size_t refs;
 	VkInstance instance;
 	VkDebugUtilsMessengerEXT messenger;
 
diff --git a/include/wlr/render/vulkan.h b/include/wlr/render/vulkan.h
--- a/include/wlr/render/vulkan.h
+++ b/include/wlr/render/vulkan.h
@@ -20,6 +20,24 @@
 const struct wlr_drm_format_set *wlr_vk_renderer_get_copy_formats(struct wlr_renderer *renderer);
 
 #define WLR_AQUEOUS_RENDER_HOOK_VERSION 10
+
+#define WLR_AQUEOUS_VULKAN_SELECTION_VERSION 1
+struct wlr_backend;
+struct wlr_vk_renderer_candidates;
+/**
+ * Snapshot usable Vulkan physical devices in preferred hardware, other hardware,
+ * then CPU order. Explicit WLR_RENDER_DRM_DEVICE and FORCE_SOFTWARE restrictions
+ * are honored. No renderer or logical device is created until next().
+ */
+struct wlr_vk_renderer_candidates *wlr_vk_renderer_candidates_create(
+	struct wlr_backend *backend, bool allow_software);
+/** Try remaining candidates until one renderer is created, or return NULL. */
+struct wlr_renderer *wlr_vk_renderer_candidates_next(
+	struct wlr_vk_renderer_candidates *candidates);
+/** Returned renderers remain valid after destroying the candidates. */
+void wlr_vk_renderer_candidates_destroy(struct wlr_vk_renderer_candidates *candidates);
+/** Recreate this exact physical device for recovery without migrating clients. */
+struct wlr_renderer *wlr_vk_renderer_recreate(struct wlr_renderer *renderer);
 
 struct wlr_vk_image_attribs {
 	VkImage image;
diff --git a/render/vulkan/renderer.c b/render/vulkan/renderer.c
--- a/render/vulkan/renderer.c
+++ b/render/vulkan/renderer.c
@@ -2732,6 +2732,9 @@
 	VkResult res;
 	if (!(renderer = calloc(1, sizeof(*renderer)))) {
 		wlr_log_errno(WLR_ERROR, "failed to allocate wlr_vk_renderer");
+		struct wlr_vk_instance *ini = dev->instance;
+		vulkan_device_destroy(dev);
+		vulkan_instance_destroy(ini);
 		return NULL;
 	}
 
@@ -2840,6 +2843,21 @@
 	return vk_renderer->dev->instance->instance;
 }
 
+struct wlr_renderer *wlr_vk_renderer_recreate(struct wlr_renderer *renderer) {
+	struct wlr_vk_device *old = vulkan_get_renderer(renderer)->dev;
+	struct wlr_vk_device *dev = vulkan_device_create(old->instance, old->phdev);
+	if (!dev) {
+		return NULL;
+	}
+	dev->drm_fd = vulkan_open_phdev_drm_fd(old->phdev);
+	old->instance->refs++;
+	struct wlr_renderer *replacement = vulkan_renderer_create_for_device(dev);
+	if (replacement) {
+		replacement->features.timeline &= renderer->features.timeline;
+	}
+	return replacement;
+}
+
 VkPhysicalDevice wlr_vk_renderer_get_physical_device(struct wlr_renderer *renderer) {
 	struct wlr_vk_renderer *vk_renderer = vulkan_get_renderer(renderer);
 	return vk_renderer->dev->phdev;
