+	if (output_pick_format(output, display_formats, format, DRM_FORMAT_ARGB8888)) {
+		return true;
+	}
+#if WLR_HAS_VULKAN_RENDERER
+	/* nvidia cursor planes scan out LINEAR only, which the Vulkan device
+	 * cannot render to. Fall back to the display format: the render pass
+	 * renders the cursor (with its GPU color transform) into an internal
+	 * tiled image and copies into the LINEAR buffer on the GPU. The failed
+	 * pick above finished `format` without zeroing it; reset before copying
+	 * so the copy does not finish the dangling modifiers a second time. */
+	if (display_formats != NULL && wlr_renderer_is_vk(output->renderer)) {
+		const struct wlr_drm_format *display =
+			wlr_drm_format_set_get(display_formats, DRM_FORMAT_ARGB8888);
+		if (display != NULL) {
+			*format = (struct wlr_drm_format){0};
+			if (wlr_drm_format_copy(format, display)) {
+				return true;
+			}
+		}
+	}
+#endif
+	return false;
 }
 
