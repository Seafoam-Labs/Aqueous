+/* Whether hardware conversion needs the encode behind blending: no discovered
+ * pipeline can express a terminal encode curve (nvidia's all end in linear
+ * light). A pipeline whose last op is a curve advertising an inverse EOTF can
+ * take the encode directly. */
+bool drm_color_pipeline_needs_post_blend(struct wlr_drm_backend *drm, struct wlr_drm_plane *plane) {
+	struct color_plane *cp = plane ? plane->color_pipeline : NULL;
+	if (!drm->color_pipeline_enabled || !cp || !cp->len) {
+		return false;
+	}
+	for (size_t i = 0; i < cp->len; i++) {
+		const struct color_pipeline *p = &cp->pipelines[i];
+		const struct colorop *last = &p->nodes[p->len - 1];
+		if (last->type == DRM_COLOROP_1D_CURVE && last->curves) {
+			for (int e = 0; e < last->curves->count_enums; e++) {
+				if (strstr(last->curves->enums[e].name, "Inverse") != NULL) {
+					return false;
+				}
+			}
+		}
+	}
+	return true;
+}
