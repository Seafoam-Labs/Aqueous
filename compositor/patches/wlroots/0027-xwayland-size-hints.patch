xwayland: notify hint removal and ignore fields not selected by ICCCM flags

Deleting WM_NORMAL_HINTS must invalidate compositor-cached constraints. Also
normalize the optional increment and aspect fields like the min/max fields:
clients may retain old field values while clearing their validity flags.

--- a/xwayland/xwm.c
+++ b/xwayland/xwm.c
@@ -930,6 +930,7 @@ static void read_surface_normal_hints(struct wlr_xwm *xwm,
 	xsurface->size_hints = NULL;
 
 	if (xcb_get_property_value_length(reply) == 0) {
+		wl_signal_emit_mutable(&xsurface->events.set_size_hints, NULL);
 		return;
 	}
 
@@ -961,6 +962,16 @@ static void read_surface_normal_hints(struct wlr_xwm *xwm,
 		xsurface->size_hints->max_height = -1;
 	}
 
+	if ((flags & XCB_ICCCM_SIZE_HINT_P_RESIZE_INC) == 0) {
+		xsurface->size_hints->width_inc = 0;
+		xsurface->size_hints->height_inc = 0;
+	}
+	if ((flags & XCB_ICCCM_SIZE_HINT_P_ASPECT) == 0) {
+		xsurface->size_hints->min_aspect_num = 0;
+		xsurface->size_hints->min_aspect_den = 0;
+		xsurface->size_hints->max_aspect_num = 0;
+		xsurface->size_hints->max_aspect_den = 0;
+	}
 	wl_signal_emit_mutable(&xsurface->events.set_size_hints, NULL);
 }
 
