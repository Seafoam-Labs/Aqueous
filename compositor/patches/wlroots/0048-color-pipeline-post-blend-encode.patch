+/* Kernel encode curves for the post-blend gamma LUT. PQ 125 Inverse EOTF
+ * takes linear light in the PQ 125 scale (1.0 = 80 cd/m², 125.0 = 10000);
+ * the SDR curves take [0,1] relative to reference white. */
+static bool curve_encode_eval(const char *name, double x, double *out) {
+	if (strcmp(name, "sRGB Inverse EOTF") == 0) {
+		x = fmin(fmax(x, 0.0), 1.0);
+		*out = x <= 0.0031308 ? x * 12.92 : 1.055 * pow(x, 1.0 / 2.4) - 0.055;
+		return true;
+	}
+	if (strcmp(name, "Gamma 2.2 Inverse") == 0) {
+		*out = pow(fmin(fmax(x, 0.0), 1.0), 1.0 / 2.2);
+		return true;
+	}
+	if (strcmp(name, "PQ 125 Inverse EOTF") == 0) {
+		const double m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0;
+		const double c1 = 3424.0 / 4096.0, c2 = 2413.0 / 4096.0 * 32.0;
+		const double c3 = 2392.0 / 4096.0 * 32.0;
+		double y = pow(fmin(fmax(x / 125.0, 0.0), 1.0), m1);
+		*out = pow((c1 + c2 * y) / (1.0 + c3 * y), m2);
+		return true;
+	}
+	return false;
+}
+
+static bool encode_curve(enum wlr_color_transfer_function tf, const char **name) {
+	switch (tf) {
+	case WLR_COLOR_TRANSFER_FUNCTION_SRGB:
+		*name = "sRGB Inverse EOTF";
+		return true;
+	case WLR_COLOR_TRANSFER_FUNCTION_GAMMA22:
+		*name = "Gamma 2.2 Inverse";
+		return true;
+	case WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ:
+		*name = "PQ 125 Inverse EOTF";
+		return true;
+	default:
+		return false;
+	}
+}
+
+struct wlr_color_transform *color_pipeline_encode_lut(
+	enum wlr_color_transfer_function tf, double linear_max, size_t dim) {
+	const char *name;
+	if (!encode_curve(tf, &name) || !isfinite(linear_max) || linear_max <= 0.0 ||
+		dim < 2 || dim > 65536) {
+		return NULL;
+	}
+	uint16_t *lut = malloc(3 * dim * sizeof(*lut));
+	if (!lut) {
+		return NULL;
+	}
+	for (size_t i = 0; i < dim; i++) {
+		double v;
+		if (!curve_encode_eval(name, (double)i / (dim - 1) * linear_max, &v)) {
+			free(lut);
+			return NULL;
+		}
+		uint16_t q = (uint16_t)llround(fmin(fmax(v, 0.0), 1.0) * UINT16_MAX);
+		lut[i] = lut[dim + i] = lut[2 * dim + i] = q;
+	}
+	struct wlr_color_transform *tr =
+		wlr_color_transform_init_lut_3x1d(dim, lut, lut + dim, lut + 2 * dim);
+	free(lut);
+	return tr;
+}
+
+bool color_pipeline_retarget_linear(struct color_pipeline_recipe *r, double linear_max,
+	enum wlr_color_transfer_function *encode_tf) {
+	if (!isfinite(linear_max) || linear_max <= 0.0 || r->len == 0 ||
+		r->ops[r->len - 1].type != CP_CURVE) {
+		return false;
+	}
+	const char *name = r->ops[r->len - 1].curve;
+	enum wlr_color_transfer_function tf;
+	if (strcmp(name, "sRGB Inverse EOTF") == 0) {
+		tf = WLR_COLOR_TRANSFER_FUNCTION_SRGB;
+	} else if (strcmp(name, "Gamma 2.2 Inverse") == 0) {
+		tf = WLR_COLOR_TRANSFER_FUNCTION_GAMMA22;
+	} else if (strcmp(name, "PQ 125 Inverse EOTF") == 0) {
+		tf = WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ;
+	} else {
+		return false;
+	}
+	/* Keep the PQ 125 normalization ahead of the stripped curve: the plane
+	 * then outputs linear light in the encode curve's input scale, divided
+	 * by linear_max. The matching CRTC LUT re-applies the encode. */
+	r->len--;
+	struct color_pipeline_op *op = append(r, CP_MULTIPLIER);
+	if (!op) {
+		return false;
+	}
+	op->multiplier = 1.0 / linear_max;
+	*encode_tf = tf;
+	return true;
+}
