+/* Content-stable CRTC gamma LUT blobs for the supplied-transform path. The
+ * committed blob plus its contents snapshot is the cache: prepare borrows the
+ * committed ID while the contents match, apply transfers ownership of a new
+ * blob and refreshes the snapshot, rollback never destroys a borrowed ID.
+ * A fresh ID per commit would make drivers treat every flip as a gamma
+ * update, the same churn the colorop DATA blobs avoid. */
+
+struct drm_color_lut *drm_color_gamma_lut_contents(size_t dim, const uint16_t *lut) {
+	if (dim == 0) {
+		return NULL;
+	}
+	struct drm_color_lut *gamma = malloc(dim * sizeof(*gamma));
+	if (!gamma) {
+		return NULL;
+	}
+	for (size_t i = 0; i < dim; i++) {
+		gamma[i].red = lut[i];
+		gamma[i].green = lut[dim + i];
+		gamma[i].blue = lut[2 * dim + i];
+		gamma[i].reserved = 0;
+	}
+	return gamma;
+}
+
+bool drm_color_gamma_lut_blob(struct wlr_drm_backend *drm, struct wlr_drm_crtc *crtc,
+	size_t dim, const uint16_t *lut, uint32_t *blob_id, bool *cached) {
+	*cached = false;
+	if (dim == 0) {
+		*blob_id = 0;
+		return true;
+	}
+	struct drm_color_lut *gamma = drm_color_gamma_lut_contents(dim, lut);
+	if (!gamma) {
+		return false;
+	}
+	size_t size = dim * sizeof(*gamma);
+	if (crtc->gamma_lut && crtc->gamma_lut_data && crtc->gamma_lut_size == size &&
+		memcmp(crtc->gamma_lut_data, gamma, size) == 0) {
+		free(gamma);
+		*blob_id = crtc->gamma_lut;
+		*cached = true;
+		return true;
+	}
+	uint32_t created = 0;
+	if (drmModeCreatePropertyBlob(drm->fd, gamma, size, &created) != 0) {
+		free(gamma);
+		return false;
+	}
+	free(gamma);
+	*blob_id = created;
+	return true;
+}
+
+void drm_color_gamma_lut_apply(struct wlr_drm_backend *drm, struct wlr_drm_crtc *crtc,
+	uint32_t blob_id, bool cached, size_t dim, const uint16_t *lut) {
+	if (cached) {
+		/* Borrowed committed blob; the contents snapshot already matches. */
+		return;
+	}
+	if (crtc->gamma_lut != blob_id) {
+		if (crtc->gamma_lut) {
+			drmModeDestroyPropertyBlob(drm->fd, crtc->gamma_lut);
+		}
+		crtc->gamma_lut = blob_id;
+	}
+	free(crtc->gamma_lut_data);
+	crtc->gamma_lut_data = drm_color_gamma_lut_contents(dim, lut);
+	crtc->gamma_lut_size = crtc->gamma_lut_data ? dim * sizeof(struct drm_color_lut) : 0;
+}
+
+void drm_color_gamma_lut_rollback(struct wlr_drm_backend *drm, struct wlr_drm_crtc *crtc,
+	uint32_t blob_id, bool cached) {
+	if (cached) {
+		return;
+	}
+	if (blob_id && crtc->gamma_lut != blob_id) {
+		drmModeDestroyPropertyBlob(drm->fd, blob_id);
+	}
+}
+
+void drm_color_gamma_lut_finish(struct wlr_drm_backend *drm, struct wlr_drm_crtc *crtc) {
+	if (crtc->gamma_lut) {
+		drmModeDestroyPropertyBlob(drm->fd, crtc->gamma_lut);
+		crtc->gamma_lut = 0;
+	}
+	free(crtc->gamma_lut_data);
+	crtc->gamma_lut_data = NULL;
+	crtc->gamma_lut_size = 0;
+}
