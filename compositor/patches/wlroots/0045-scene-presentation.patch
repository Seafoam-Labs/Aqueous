+// Presentation belongs to the node, never to a duplicate surface generation.
+struct scene_node_presentation {
+	struct wlr_addon addon;
+	double dx, dy;
+	bool input_enabled, clipped, input_clipped;
+	struct wlr_box clip, input_clip;
+};
+
+static void presentation_destroy(struct wlr_addon *addon) {
+	struct scene_node_presentation *state = wl_container_of(addon, state, addon);
+	wlr_addon_finish(addon);
+	free(state);
+}
+
+static const struct wlr_addon_interface presentation_impl = {
+	.name = "aqueous-presentation", .destroy = presentation_destroy,
+};
+
+static struct scene_node_presentation *presentation(struct wlr_scene_node *node) {
+	struct wlr_addon *addon = wlr_addon_find(&node->addons, NULL, &presentation_impl);
+	return addon ? wl_container_of(addon, (struct scene_node_presentation *)NULL, addon) : NULL;
+}
+
+bool wlr_scene_node_presentation_coords(struct wlr_scene_node *node, double *x, double *y) {
+	*x = *y = 0;
+	bool enabled = true;
+	for (; node; node = node->parent ? &node->parent->node : NULL) {
+		double nx, ny;
+		scene_node_local_position(node, &nx, &ny);
+		struct scene_node_presentation *state = presentation(node);
+		*x += nx + (state ? state->dx : 0);
+		*y += ny + (state ? state->dy : 0);
+		enabled &= node->enabled;
+	}
+	return enabled;
+}
+
+static bool presentation_coords(struct wlr_scene_node *node, int *x, int *y) {
+	double px, py;
+	bool enabled = wlr_scene_node_presentation_coords(node, &px, &py);
+	*x = round(px); *y = round(py);
+	return enabled;
+}
+
+static void presentation_clip(struct wlr_scene_node *node, pixman_region32_t *region) {
+	for (; node; node = node->parent ? &node->parent->node : NULL) {
+		struct scene_node_presentation *state = presentation(node);
+		if (state && state->clipped) {
+			const struct wlr_box *clip = &state->clip;
+			pixman_region32_intersect_rect(region, region,
+				clip->x, clip->y, clip->width, clip->height);
+		}
+	}
+}
+
+static bool presentation_requires_composition(struct wlr_scene_node *node) {
+	for (; node; node = node->parent ? &node->parent->node : NULL) {
+		struct scene_node_presentation *state = presentation(node);
+		if (state && (state->dx != 0 || state->dy != 0 || state->clipped)) return true;
+	}
+	return false;
+}
