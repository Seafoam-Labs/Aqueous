+bool wlr_scene_node_set_presentation(struct wlr_scene_node *node,
+		double dx, double dy, const struct wlr_box *clip,
+		bool input_enabled, const struct wlr_box *input_clip) {
+	assert(isfinite(dx) && isfinite(dy));
+	assert(!clip || (clip->width >= 0 && clip->height >= 0));
+	assert(!input_clip || (input_clip->width >= 0 && input_clip->height >= 0));
+	struct scene_node_presentation *state = presentation(node);
+	if (!state) {
+		state = calloc(1, sizeof(*state));
+		if (!state) return false;
+		state->input_enabled = true;
+		wlr_addon_init(&state->addon, &node->addons, NULL, &presentation_impl);
+	}
+	bool visual_changed = state->dx != dx || state->dy != dy ||
+		state->clipped != (clip != NULL) || (clip && !wlr_box_equal(clip, &state->clip));
+	state->input_enabled = input_enabled;
+	state->input_clipped = input_clip != NULL;
+	if (input_clip) state->input_clip = *input_clip;
+	if (!visual_changed) return true;
+	// Existing visibility is in the OLD presentation space. Update computes
+	// the union with the new bounds, including newly exposed background.
+	state->dx = dx; state->dy = dy;
+	state->clipped = clip != NULL;
+	if (clip) state->clip = *clip;
+	scene_node_update(node, NULL);
+	return true;
 }
 
