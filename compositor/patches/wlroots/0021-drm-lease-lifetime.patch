+				// The inactive/removed device cannot acknowledge a session lock.
+				wlr_log_errno(WLR_ERROR, "Cannot blank inactive leased CRTC");
+			} else {
+				wlr_log_errno(WLR_ERROR, "Cannot blank leased CRTC; aborting");
