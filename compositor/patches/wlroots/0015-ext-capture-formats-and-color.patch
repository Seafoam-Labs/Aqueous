+		  desc->primaries == WLR_COLOR_NAMED_PRIMARIES_BT2020)) ||
+		(desc->transfer_function == WLR_COLOR_TRANSFER_FUNCTION_GAMMA22 &&
+		 desc->primaries == WLR_COLOR_NAMED_PRIMARIES_SRGB);
+}
