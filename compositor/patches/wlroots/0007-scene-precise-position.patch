+bool wlr_scene_node_coords_f64(struct wlr_scene_node *node,
+		double *lx_ptr, double *ly_ptr) {
+	assert(node);
+
+	double lx = 0, ly = 0;
+	bool enabled = true;
+	while (true) {
+		double x, y;
+		scene_node_local_position(node, &x, &y);
+		lx += x;
+		ly += y;
+		enabled = enabled && node->enabled;
+		if (node->parent == NULL) {
+			break;
+		}
+		node = &node->parent->node;
+	}
+
+	*lx_ptr = lx;
+	*ly_ptr = ly;
+	return enabled;
+}
