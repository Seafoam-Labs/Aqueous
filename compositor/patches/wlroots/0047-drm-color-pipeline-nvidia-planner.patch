+		if (oi == s->r->len && gain_placed(gain) && (!s->found || cost < s->best_cost)) {
+			memcpy(s->best, s->current, ni * sizeof(*s->best));
+			s->best_cost = cost;
+			s->found = true;
+		}
+		return;
+	}
