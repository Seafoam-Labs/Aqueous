+static bool plan_pipeline(const struct color_pipeline *p, const struct color_pipeline_recipe *r,
+	uint32_t format, struct node_plan out[MAX_NODES]) {
+	bool effective[MAX_NODES];
+	if (!pipeline_effective(p, format, effective)) {
+		return false;
+	}
+	struct plan_search s = {
+		.p = p, .r = r, .effective = effective, .budget = 4096, .best_cost = UINT_MAX,
+	};
+	plan_node(&s, 0, 0, 1.0, 0);
+	if (!s.found) {
+		return false;
+	}
+	memcpy(out, s.best, p->len * sizeof(*out));
+	return true;
 }
 
