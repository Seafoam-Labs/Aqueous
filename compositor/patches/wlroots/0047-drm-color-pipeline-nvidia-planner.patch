+	const struct color_pipeline_op *op = oi < s->r->len ? &s->r->ops[oi] : NULL;
+	uint64_t fixed;
+	struct node_plan np;
+
+	/* Stage placements first, so equal-cost plans use the earliest ops.
+	 * A pending gain folds into a consumed multiplier or matrix (scalars
+	 * commute; the matrix scales its input columns, not the offset); curves
+	 * and client LUTs must wait until it is placed to preserve recipe order. */
