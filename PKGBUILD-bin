pkgname=aqueous-bin
pkgbase=aqueous
pkgver=0.1.0
pkgrel=2
pkgdesc="Aqueous Wayland window manager bundled with RiverDelta (prebuilt binary release)"
arch=('x86_64')
url="https://github.com/Seafoam-Labs/Aqueous"
license=('GPL3')
depends=('wayland' 'wayland-protocols' 'libxkbcommon' 'libinput'
         'pixman' 'libdrm' 'libevdev' 'wlr-randr'
         'noctalia-shell' 'libdecor' 'grim' 'xwayland-satellite'
         'xdg-desktop-portal-wlr' 'wlroots0.20' 'wl-clipboard'
         'swaylock-effects' 'swayidle')
optdepends=('tuigreet: TUI greeter for greetd (recommended login path)'
            'greetd: minimal login manager for tuigreet'
            'aqueous-greetd-config: opinionated greetd+tuigreet preset for Aqueous'
            'ghostty: recommended terminal emulator'
            'nemo: recommended file manager'
            'firefox: web browser')
provides=('aqueous' 'riverdelta')
conflicts=('aqueous' 'aqueous-git' 'riverdelta')
install=aqueous.install
source_x86_64=(
    "Aqueous-linux-x64-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/Aqueous-linux-x64.tar.gz"
)
# Update this checksum when bumping pkgver to match the published release.
sha256sums_x86_64=('SKIP')

package() {
    # The release tarball is staged with a /bin, /share, /lib, /etc layout
    # rooted at the archive top-level. Install it into $pkgdir mirroring
    # the binary build output of the source PKGBUILD.
    install -d "$pkgdir/usr"

    # Binaries
    install -d "$pkgdir/usr/bin"
    install -Dm755 "$srcdir/bin/aqueous"          "$pkgdir/usr/bin/aqueous"
    install -Dm755 "$srcdir/bin/aqueous-inputd"   "$pkgdir/usr/bin/aqueous-inputd"
    install -Dm755 "$srcdir/bin/aqueous-outputd"  "$pkgdir/usr/bin/aqueous-outputd"
    install -Dm755 "$srcdir/bin/riverdelta"       "$pkgdir/usr/bin/riverdelta"
    install -Dm755 "$srcdir/bin/aqueous-init"     "$pkgdir/usr/bin/aqueous-init"
    install -Dm755 "$srcdir/bin/aqueous-wm"       "$pkgdir/usr/bin/aqueous-wm"

    # Shared data (wayland-sessions, aqueous config tree, RiverDelta man pages, etc.)
    if [ -d "$srcdir/share" ]; then
        install -d "$pkgdir/usr/share"
        cp -dr --no-preserve=ownership "$srcdir/share/." "$pkgdir/usr/share/"
    fi

    # systemd user units
    if [ -d "$srcdir/lib/systemd/user" ]; then
        install -d "$pkgdir/usr/lib/systemd/user"
        cp -dr --no-preserve=ownership "$srcdir/lib/systemd/user/." \
            "$pkgdir/usr/lib/systemd/user/"
    fi

    # udev rules
    if [ -d "$srcdir/lib/udev/rules.d" ]; then
        install -d "$pkgdir/usr/lib/udev/rules.d"
        cp -dr --no-preserve=ownership "$srcdir/lib/udev/rules.d/." \
            "$pkgdir/usr/lib/udev/rules.d/"
    fi

    # Default system-wide config
    if [ -d "$srcdir/etc" ]; then
        install -d "$pkgdir/etc"
        cp -dr --no-preserve=ownership "$srcdir/etc/." "$pkgdir/etc/"
    fi
}
