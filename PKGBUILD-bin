# Maintainer: Zoey Bauer <zoey.erin.bauer@gmail.com>
# Component archives are introduced by the next release; do not reuse old bundles.
pkgbase=aqueous-bin
pkgname=(aqueous-core-bin aqueous-session-bin aqueous-welcome-bin xdg-desktop-portal-aqueous-bin aqueous-integration-dms-bin aqueous-integration-noctalia-bin aqueous-integration-pearl-bin aqueous-shell-dms-bin aqueous-shell-noctalia-bin aqueous-shell-pearl-bin aqueous-bin)
pkgver=0.7.0
pkgrel=2
# Keep tested binary/library bytes and component manifests stable.
options=('!strip' '!debug' '!zipman')
pkgdesc="Aqueous component packages (prebuilt release)"
arch=('x86_64')
url="https://github.com/Seafoam-Labs/Aqueous"
license=('GPL-3.0-only' 'MIT')
makedepends=('bash' 'jq' 'binutils')
source=("Aqueous-components-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/Aqueous-components-${pkgver}-x86_64.tar.gz")
# The release process must replace this before publishing the binary recipe.
# Intentionally fail closed instead of accepting SKIP for executable archives.
sha256sums=('REPLACE_WITH_RELEASE_SHA256')

check() {
    bash "$srcdir/components/tools/verify-release.sh" "$srcdir/components" --version "$pkgver" --architecture "$CARCH"
}

_stage_component() {
    # Revalidate even when makepkg --nocheck is used.
    check
    install -d "$pkgdir"
    cp -dr --preserve=mode,timestamps --no-preserve=ownership "$srcdir/components/$1/root/." "$pkgdir/"
}

package_aqueous-core-bin() {
    pkgdesc="Aqueous core (prebuilt)"
    depends=("freetype2" "wayland" "libxkbcommon" "libinput" "pixman" "libpng" "libdrm" "libevdev" "libdecor" "xorg-xwayland" "pipewire" "glib2" "fontconfig" "mesa" "systemd-libs" "seatd" "libdisplay-info" "libliftoff" "lcms2" "vulkan-icd-loader" "libxcb" "xcb-util-errors" "xcb-util-wm" "xcb-util-renderutil")
    conflicts=('aqueous-git' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-core' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
    provides=("aqueous-core=$pkgver-$pkgrel")
    _stage_component core
}

package_aqueous-session-bin() {
    pkgdesc="Aqueous session (prebuilt)"
    depends=("aqueous-core-bin=$pkgver-$pkgrel" "bash" "jq" "coreutils" "uwsm" "dbus" "systemd" "ghostty" "grim" "slurp" "wl-clipboard" "libnotify" "xdg-desktop-portal" "xdg-desktop-portal-gtk")
    conflicts=('aqueous-git' 'aqueous-git-intel' 'aqueous-git-dms' 'aqueous-session' 'aqueous<0.7.0-2' 'aqueous-bin<0.7.0-2')
    provides=("aqueous-session=$pkgver-$pkgrel")
    backup=('etc/xdg/aqueous/wm.toml' 'etc/xdg/aqueous/outputs.toml' 'etc/xdg/uwsm/env-aqueous' 'etc/xdg/menus/aqueous-applications.menu' 'etc/xdg/xdg-desktop-portal-aqueous/config')
    _stage_component session
}

